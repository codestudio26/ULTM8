{
  "name": "ultm8",
  "private": true,
  "description": "ULTM8 monorepo — Turborepo workspace (npm workspaces). See skills/ultm8-nestjs-module/SKILL.md §6 for the layout this mirrors.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
