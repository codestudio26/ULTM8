{
  "permissions": {
    "allow": [
      "Bash(npx jest *)",
      "Bash(echo \"BUILD EXIT:$?\")",
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(git add *)",
      "Bash(git commit -m 'Fix migration role-creation ordering \\(CI run P3018\\) *)",
      "Bash(git push *)",
      "Bash(git commit -m 'Update Claude Code permissions allowlist *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-advisor.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-advisor.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
