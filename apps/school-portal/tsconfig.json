{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "target": "ES2020",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
