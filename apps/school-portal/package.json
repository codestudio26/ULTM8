{
  "name": "@ultm8/school-portal",
  "version": "0.1.0",
  "private": true,
  "description": "React — School Portal (Spec §4.2). Tenant-facing web app: School/Branch management, auth, and staff invitations built in Phase 3. As of Phase 14, apps/api has 14 more backend modules (Classes, Timetable, Instructors, Memberships, Transactions, Waivers, Ranks, Booking/Waitlist, Guardians, Attendance, Academies, Settings, Payments) with no corresponding UI here yet — the endpoints exist and are stable, the screens for them just haven't been built.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@ultm8/api-client": "*",
    "@ultm8/auth": "*",
    "@ultm8/i18n": "*",
    "@ultm8/ui": "*",
    "libphonenumber-js": "^1.11.0",
    "luxon": "^3.7.2",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "1.56.1",
    "@types/luxon": "^3.7.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": "\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true
          }
        }
      ]
    }
  }
}
