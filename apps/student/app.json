{
  "expo": {
    "name": "ULTM8 Student",
    "slug": "ultm8-student",
    "scheme": "ultm8-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ultm8.student",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "app.ultm8.student",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ULTM8 uses your camera to scan the Class check-in QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ULTM8 uses your photos to set your profile picture.",
          "cameraPermission": "ULTM8 uses your camera to take your profile picture."
        }
      ],
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ]
  }
}
