{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install --workspace=apps/student --include-workspace-root=true --include=dev --no-audit --no-fund",
  "buildCommand": "if [ -z \"$EXPO_PUBLIC_API_BASE_URL\" ]; then echo 'Set EXPO_PUBLIC_API_BASE_URL (the API address) in the Vercel project.' >&2; exit 1; fi; npx expo export -p web --clear --output-dir dist",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
