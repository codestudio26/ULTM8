// ULTM8 Prisma schema — Phase 1 walking skeleton.
//
// Scope: exactly the 6 core entities named in Phase 1's task — User, RoleGrant,
// AdminUser, Franchise, School, Branch. Everything else (Class, Booking, Membership,
// Waiver, StudentRank, ...) is out of scope for this pass and intentionally absent.
//
// Sources (cite-back, per ultm8-domain-rules §20 rule 5):
//   - Field lists: ultm8-domain-rules §2/§3/§6.1, Spec 55 §6.1 (Franchise/School entity rows)
//   - Branch field set: Decision 76, docs/decisions/POST-SPEC-55-DECISION-LOG.md
//   - RoleGrant shape (user_id, role, scope, granted_by, granted_at, revoked_at): domain-rules §3
//   - AdminUser as a wholly separate identity, never joined to User: ultm8-tenant-isolation §3
//   - RLS keying (franchise_id/school_id, +branch_id for the 4 Branch-scoped entities —
//     none of which exist yet in this schema pass): ultm8-tenant-isolation §2
//   - Composite indexes leading with the tenant column: Decision 30
//
// RLS policies are NOT expressible in schema.prisma (Prisma has no first-class RLS
// feature) — they live in prisma/migrations/20260902000000_init/migration.sql, hand-
// authored and clearly marked as a Developer-level design applying the confirmed
// tenant-isolation principles above. Flagged for Architect review, same as the AuthModule
// lockout/recovery minimum below — see the Phase 1 summary for the full list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The 6 confirmed customer-facing roles a RoleGrant can carry (Spec 55 §8.2).
/// Platform Admin is deliberately excluded — that's the separate AdminUser realm below,
/// never a RoleGrant value (ultm8-tenant-isolation §3).
enum Role {
  STUDENT
  SCHOOL_OWNER_MANAGER
  BRANCH_STAFF
  INSTRUCTOR
  FRANCHISE_OWNER
  GUARDIAN
}

/// Platform Admin's three least-privilege sub-roles (ultm8-tenant-isolation §3).
enum AdminSubRole {
  SUPPORT
  BILLING_PAYMENTS_OPS
  FULL_ADMIN
}

/// Franchise.feeModel — Flat or Per-Headcount (domain-rules §2, confirmed).
enum FeeModel {
  FLAT
  PER_HEADCOUNT
}

/// School.classCancellationPolicy — Manual (default) / Auto-Refund / Auto-Credit
/// (domain-rules §7, confirmed). Not exercised by any Phase 1 endpoint yet — Bookings/
/// Classes are out of scope — but it's a confirmed School-entity column, so it's modeled
/// now rather than half-modeling School.
enum ClassCancellationPolicy {
  MANUAL
  AUTO_REFUND
  AUTO_CREDIT
}

/// School.franchiseFeeSubscriptionStatus — synced from the Franchise-fee Stripe
/// Subscription (domain-rules §2, Spec §6.1). Nullable on the model since it only
/// applies to a School actually under a Franchise.
enum FranchiseFeeSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// TimetableSlot.weekday — Phase 5. Confirmed field ("Week day"), Spec 55 §6.1.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// TimetableSlot.status — Phase 5. Confirmed field ("status (On/Off)"), Spec 55 §6.1 —
/// modeled as this exact On/Off language, not a generic isActive boolean, so the schema
/// reads the same as the spec.
enum TimetableSlotStatus {
  ON
  OFF
}

/// PaymentAccount.provider — Phase 8. Confirmed field ("Provider (Stripe/Cash/Bank
/// Transfer per Section 1.2 decision)"), Spec 55 §6.1.
enum PaymentAccountProvider {
  STRIPE
  CASH
  BANK_TRANSFER
}

/// PaymentAccount.status — Phase 8. Confirmed field ("status (Active/De-active)"),
/// Spec 55 §6.1 — kept as this exact spelling, not normalized to a generic INACTIVE,
/// same "read the same as the spec" convention TimetableSlotStatus above already set.
enum PaymentAccountStatus {
  ACTIVE
  DE_ACTIVE
}

/// PaymentAccount.mode — Phase 8. Confirmed field ("mode (Live/Test)"), Spec 55 §6.1.
enum PaymentAccountMode {
  LIVE
  TEST
}

/// MembershipPlan.type — Phase 9. Confirmed field (Spec 55 §6.1, quoted: "Subscription
/// / Class Pack / Weekly Pass / Friend Pass / Trial Membership — Friend Pass added
/// 25 Aug 2026: School-gifted, not purchased, always £0; Class Pack replaces the
/// earlier 'Single Pass' concept, revised 25 Aug 2026"). CORRECTION (found on
/// review): an earlier draft of this comment claimed this "supersedes a stale
/// 3-value read" in skills/ultm8-domain-rules/SKILL.md §6 — checked directly
/// against that file's actual on-disk content in this repo and found it ALREADY
/// correctly documents all five values, matching Spec 55 exactly. The stale
/// 3-value content the earlier draft was actually comparing against came from a
/// different, cached copy the Skill-loading tool pulled from an installed-plugin
/// directory outside this repo, not this file — a lesson in verifying against the
/// actual repo path, not a tool's loaded content, when both exist. No correction to
/// the skill file is needed; it was already right.
enum MembershipPlanType {
  SUBSCRIPTION
  CLASS_PACK
  WEEKLY_PASS
  FRIEND_PASS
  TRIAL_MEMBERSHIP
}

/// Membership.status — Phase 9. Confirmed field (Decision 6,
/// docs/decisions/POST-SPEC-55-DECISION-LOG.md-style entry in Spec 55 itself, 26 Aug
/// 2026 Pass 5): "Membership.Status is Active/Expired only — Pending is removed
/// entirely... A Membership row is now created, not status-flipped, at the moment its
/// payment settles." The on-screen "Pending" badge the designs show reflects the
/// underlying Transaction's own Pending status against a not-yet-created Membership,
/// never a Membership.status value — skills/ultm8-domain-rules/SKILL.md §8 already
/// documents this exactly correctly (see MembershipPlanType's own comment above for
/// a correction on an earlier draft's mistaken claim that this skill was stale).
enum MembershipStatus {
  ACTIVE
  EXPIRED
}

/// Membership.frequency — Phase 9. Confirmed field (Spec 55 §6.1, quoted: "start date,
/// frequency (One Time / recurring)").
enum MembershipFrequency {
  ONE_TIME
  RECURRING
}

/// Transaction.status — Phase 9. Confirmed field (Spec 55 §6.1, quoted:
/// "Successful/Pending/Failed/Refunded/Disputed — Failed and Refunded added 25 Aug
/// 2026... Disputed added Pass 8, Decision 55, only reachable for Stripe-paid
/// Transactions since Cash/Bank Transfer rows have no Stripe charge id to match").
/// DISPUTED is modeled for schema completeness only — no Phase 9 code path ever sets
/// it (Decision 55's dispute handling is out of scope this phase; see the Phase 9
/// kickoff prompt §3).
enum TransactionStatus {
  SUCCESSFUL
  PENDING
  FAILED
  REFUNDED
  DISPUTED
}

// Transaction.paymentMethod (Spec 55 §6.1, quoted: "payment method (Stripe/Cash/Bank
// Transfer — GoCardless appeared in the designs but is excluded per Section 1.2"))
// reuses PaymentAccountProvider directly, below — identical STRIPE/CASH/BANK_TRANSFER
// membership and exclusion rationale (Decision 5); a second enum with the same three
// values would be pure duplication.

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

/// Base customer-facing identity shared by every tenant-side role (Student, School
/// Owner/Manager, Branch Staff, Instructor, Franchise Owner, Guardian). Role/scope is
/// NEVER a column here — RoleGrant is the sole source of truth (domain-rules §3).
model User {
  id    String @id @default(uuid())
  email String @unique
  phone String @unique // E.164, validated at the DTO layer

  firstName String
  surname   String
  username  String? @unique // mobile-only per confirmed field list; nullable elsewhere

  /// bcrypt hash of the 6-digit passcode — the account's sole login credential
  /// (Decision 72). Never store the raw passcode.
  passcodeHash String

  /// Set once Twilio Verify OTP confirms this phone (Spec §8.1's registerScreen ->
  /// verificationPin flow). NOT a confirmed schema field — a Developer-added column
  /// needed to make that two-step, spec-described flow actually functional; flagged
  /// for Architect review. Login is blocked while this is null (see AuthService) —
  /// that gate is a reasonable-minimum choice, not a confirmed business rule; flag if
  /// wrong.
  phoneVerifiedAt DateTime?

  dateOfBirth     DateTime @db.Date // ISO 8601 date, no time component (confirmed)
  gender          String?
  nationality     String?
  language        String? // one of the 4 confirmed languages; stored as free text pending
  // a confirmed canonical code list (not specified anywhere)
  currency        String? // one of the 6 confirmed currencies; same caveat as above
  address         String?
  profilePhotoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleGrants               RoleGrant[]       @relation("RoleGrantUser")
  grantsIssued             RoleGrant[]       @relation("RoleGrantGrantedBy")
  classesTaught            Class[]           @relation("ClassInstructor")
  timetableSlotsTaught     TimetableSlot[]   @relation("TimetableSlotInstructor")
  instructorProfiles       Instructor[]
  lessonsAuthored          Lesson[]          @relation("LessonInstructor")
  memberships              Membership[]      @relation("MembershipStudent")
  membershipsGifted        Membership[]      @relation("MembershipGiftedBy")
  transactionsPaid         Transaction[]     @relation("TransactionPayer")
  studentRanks             StudentRank[]
  promotionEventsPerformed PromotionEvent[]  @relation("PromotionEventPerformedBy")
  waiverSignatures         WaiverSignature[] @relation("WaiverSignatureStudent")
  waiverSignaturesSigned   WaiverSignature[] @relation("WaiverSignatureSignedBy")
  bookings                 Booking[]         @relation("BookingStudent")
  bookingsOverridden       Booking[]         @relation("BookingOverriddenBy")
  bookingsResolved         Booking[]         @relation("BookingResolvedBy")
  bookingsCheckedIn        Booking[]         @relation("BookingCheckedInBy")
  bookingAttendeesResolved BookingAttendee[] @relation("BookingAttendeeResolvedBy")
  waitlistEntries          WaitlistEntry[]   @relation("WaitlistEntryStudent")
  guardianLinksAsGuardian  GuardianLink[]    @relation("GuardianLinkGuardian")
  guardianLinksAsStudent   GuardianLink[]    @relation("GuardianLinkStudent")
  consentRecordsAsGuardian ConsentRecord[]   @relation("ConsentRecordGuardian")
  consentRecordsAsStudent  ConsentRecord[]   @relation("ConsentRecordStudent")
  notifications            Notification[]
  deviceTokens             DeviceToken[]

  @@index([email])
  @@index([phone])
}

/// Platform Admin identity — wholly separate from User, never joined to it
/// (ultm8-tenant-isolation §3). Authenticates via SSO against the company's own IdP
/// (Spec §4.4); ssoSubject is the federated-identity linkage, not a local password.
model AdminUser {
  id      String       @id @default(uuid())
  email   String       @unique
  name    String
  subRole AdminSubRole

  /// Subject identifier from the external SSO IdP (§4.4) — no local credential is
  /// stored here; ULTM8 never owns Platform Admin's authentication factor directly.
  ssoSubject String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime? // access revoked immediately on offboarding (§4.4)

  auditLogEntries AuditLogEntry[]
}

/// Every Platform Admin action that touches tenant data (ultm8-tenant-isolation
/// SKILL.md §6, Spec §4.7): "who, when, what, on which tenant." Immutable by design —
/// UPDATE/DELETE are revoked at the database layer for every role, including the
/// break-glass credential (see this phase's own migration). Range-partitioned by
/// month on createdAt from the start (§6, §11.6) — see that same migration for why
/// this means `id` is NOT independently unique at the database level (Postgres
/// requires a partitioned table's primary key to include the partition key), only
/// the composite (id, createdAt) is — acceptable here since a UUID's own collision
/// probability makes `id` unique in practice, and this table's real access pattern is
/// filtered `findMany` (by actor/target/time-range), never `findUnique` by bare id.
///
/// Exact retention period is a compliance/legal input, explicitly left open by the
/// spec (§12.2) — deliberately NOT invented here; no deletion path exists on this
/// table at all yet, which is the correct default for "not yet decided," not a gap.
///
/// targetType/targetId are a deliberate polymorphic reference (School, Franchise,
/// PaymentAccount, User — whatever the action actually touched), NOT a real foreign
/// key — Postgres has no single-column FK that can point at different tables per row,
/// and an audit entry must remain permanently readable even if the target row is
/// later deleted, so no FK/cascade relationship exists to it at all (validated at the
/// application layer only). schoolId/franchiseId are a separate, direct "on which
/// tenant" reference — both nullable, whichever applies (mirrors RoleGrant's own
/// nullable-scope convention) — kept distinct from targetType/targetId specifically
/// so "which tenant" can be queried/filtered directly without joining through the
/// polymorphic reference first.
model AuditLogEntry {
  id String @default(uuid())

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  /// A short action label (e.g. "VIEW_SCHOOL") — plain string, not a DB enum: the
  /// spec's own confirmed examples ("viewing/editing another tenant's records,
  /// viewing/rotating a payment credential, impersonating a tenant user") are
  /// illustrative, not an exhaustive closed set, and a DB enum would need a migration
  /// for every future Platform Admin capability. Disciplined string constants at each
  /// call site, not a free-for-all — see AuditLogService's own header comment.
  action String

  targetType String
  targetId   String

  schoolId    String?
  franchiseId String?

  /// Freeform structured context (e.g. what changed) — deliberately optional; a
  /// read-only "viewed a record" action has nothing to put here.
  details Json?

  createdAt DateTime @default(now()) // the partition key

  @@id([id, createdAt])
  @@index([adminUserId, createdAt])
  @@index([schoolId, createdAt])
  @@index([franchiseId, createdAt])
  @@index([targetType, targetId, createdAt])
}

/// The sole source of truth for who holds what role, where (domain-rules §3, §6.1).
/// franchiseId / schoolId / branchId together encode "scope": a Franchise Owner grant
/// sets only franchiseId; a School-scoped grant (Owner/Manager, Instructor) sets
/// schoolId with branchId null (== "sees all Branches under this School", §4.3); a
/// Branch Staff grant sets both schoolId and branchId.
model RoleGrant {
  id   String @id @default(uuid())
  role Role

  userId String
  user   User   @relation("RoleGrantUser", fields: [userId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  grantedById String?
  grantedBy   User?   @relation("RoleGrantGrantedBy", fields: [grantedById], references: [id])

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId, revokedAt])
  @@index([franchiseId, revokedAt])
  @@index([branchId, revokedAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tenancy: Franchise -> School -> Branch
// ---------------------------------------------------------------------------

/// Franchise (domain-rules §2, Spec §6.1). A School's link to a Franchise is optional —
/// modeled as a nullable FK on School, not required here.
model Franchise {
  id   String @id @default(uuid())
  name String

  mobileNumber    String?
  address         String?
  type            String?
  activities      String[] @default([])
  facilities      String[] @default([])
  defaultLanguage String?
  defaultCurrency String?
  description     String?
  logoUrl         String?
  bannerUrl       String?

  feeModel FeeModel @default(FLAT)

  /// Phase 16b-ii — the actual franchise-fee rate, resolved directly with the
  /// product owner (Decision 99): self-service, the Franchise Owner sets their own
  /// rate, same shape MembershipPlan.price already uses for School->Student pricing
  /// and the same self-service precedent feeModel itself already established.
  /// Deliberately deferred out of 16b-i (see Decision 98) rather than added
  /// unilaterally — see Decision 99 for the full account. Minor-unit Int, matching
  /// every other money field in this schema; no upper bound at the schema level
  /// (Postgres INTEGER's own 2^31-1 ceiling), but validated with an explicit
  /// @Max() in CreateFranchiseDto/UpdateFranchiseDto — a first draft of these
  /// fields (16b-i) shipped without that bound and code review caught it before
  /// the fields were reverted entirely; carried forward now that they're back.
  /// Currency is NOT a separate column — domain-rules §11.2/Decision 7 confirms
  /// Franchise-fee is billed in a single anchor currency (USD) always, unlike
  /// MembershipPlan's genuinely per-currency pricing, so there is nothing to store
  /// per-Franchise here (FranchiseFeeCharge's own `currency` column is set to
  /// 'USD' in code, not read from anywhere on Franchise).
  ///
  /// Both nullable and independently settable via the existing PATCH
  /// /franchises/:id (no dedicated endpoint) regardless of which feeModel is
  /// currently active — a Franchise can exist, and even have Schools join it
  /// (Phase 16b-i), before its billing rate is configured; enforcement that the
  /// RELEVANT rate is actually set happens in the franchise-fee-usage-reporting
  /// job (this phase), which simply skips a School whose Franchise isn't fully
  /// configured yet rather than erroring.
  flatFeeAmount    Int?
  perHeadcountRate Int?

  /// Phase 16b-ii — lazily created the first time this Franchise's own
  /// PER_HEADCOUNT metered billing is set up (franchise-fee-usage-reporting job),
  /// never at Franchise creation/update time. A Stripe Billing Meter is scoped to
  /// the Stripe account it's created on — here, the Franchise's own connected
  /// account (Decision 86) — so each PER_HEADCOUNT Franchise needs its own Meter
  /// and metered Price, not a shared platform-wide one. See
  /// PaymentsService.ensureFranchiseFeeSubscription's own comment for the full
  /// Stripe-mechanics account (verified directly against the installed `stripe`
  /// SDK v22's Billing Meters API — the modern replacement for the removed legacy
  /// usage_record API, not assumed).
  stripeMeterId      String?
  stripeUsagePriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools             School[]
  roleGrants          RoleGrant[]
  paymentAccount      PaymentAccount?
  franchiseFeeCharges FranchiseFeeCharge[]

  @@index([name])
}

/// School (domain-rules §2, Spec §6.1). franchiseId is nullable — an independent,
/// non-franchised School is a first-class case, not an edge case (confirmed).
model School {
  id String @id @default(uuid())

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  name         String
  mobileNumber String?
  address      String?
  businessType String?
  activities   String[] @default([])
  facilities   String[] @default([])
  ranksToggle  Boolean  @default(false)

  defaultLanguage String?
  defaultCurrency String?
  description     String?
  logoUrl         String?
  bannerUrl       String?

  classCancellationPolicy        ClassCancellationPolicy         @default(MANUAL)
  waitlistClaimWindowMinutes     Int                             @default(120)
  franchiseFeeSubscriptionStatus FranchiseFeeSubscriptionStatus?

  /// Phase 16b-ii — the standing Stripe Subscription id backing this School's own
  /// franchise-fee billing relationship (created lazily by the
  /// franchise-fee-usage-reporting job the first time this School has both a
  /// Franchise affiliation, Phase 16b-i, and that Franchise has a configured rate +
  /// onboarded PaymentAccount). Paired with franchiseFeeSubscriptionStatus above —
  /// that field tracks the subscription's health (synced via
  /// customer.subscription.* webhooks), this field is the correlator id itself.
  /// Null for an independent School, or a Franchise-affiliated one whose billing
  /// hasn't started yet.
  stripeFranchiseFeeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches            Branch[]
  roleGrants          RoleGrant[]
  classes             Class[]
  timetableSlots      TimetableSlot[]
  instructors         Instructor[]
  paymentAccount      PaymentAccount?
  membershipPlans     MembershipPlan[]
  transactions        Transaction[]
  disciplines         Discipline[]
  waivers             Waiver[]
  franchiseFeeCharges FranchiseFeeCharge[]
  lessons             Lesson[]

  // Composite index leading with the tenant column (Decision 30) — School's own
  // "tenant column" one level up is franchiseId.
  @@index([franchiseId])
}

/// Branch (Decision 76 — field set mirrors School's profile fields; the RLS-enforced
/// access-boundary role for TimetableSlot/Class/Instructor/Booking is asserted in
/// ultm8-tenant-isolation §2 — Class is the first of those 4 to actually exist in this
/// schema, added in Phase 4; Booking/WaitlistEntry are added in Phase 11 below.
/// TimetableSlot/Instructor(-as-its-own-table) still don't exist as separate tables).
model Branch {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name             String
  address          String?
  contactPhone     String?
  timezone         String? // IANA tz name, per the glossary convention (Spec §14)
  currencyOverride String?
  logoUrl          String?
  bannerUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleGrants     RoleGrant[]
  classes        Class[]
  timetableSlots TimetableSlot[]
  instructors    Instructor[]

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
}

/// Class (domain-rules §9, Spec §6.1) — Phase 4. A bookable Class row is either
/// materialized from a recurring TimetableSlot (TimetableModule, deferred to Phase 5
/// alongside the BullMQ/Redis infrastructure the materialization job needs) or, as
/// built here, created directly as an independent, one-off event. Booking/waitlist are
/// explicitly out of scope this phase (see the Phase 4 kickoff prompt) — Booking
/// creation requires an Active Membership check (§10) and MembershipsModule/Stripe
/// integration don't exist yet, so no Booking relation is modeled here either.
///
/// instructorId points at User directly, NOT a separate Instructor table — domain-rules
/// §6.1 confirms RoleGrant (not a dedicated table) is the sole source of truth for who
/// holds the Instructor role; "taught by an Instructor" means "instructorId references a
/// User holding an active INSTRUCTOR RoleGrant at this Class's School", validated in
/// ClassesService, not enforced by a DB constraint.
///
/// branchId is nullable — not itself part of §9's confirmed field list, but Branch's own
/// role as "the RLS-enforced access boundary for ... Class" (Decision 76) requires SOME
/// branch relationship; nullable mirrors RoleGrant.branchId's already-established
/// "School-wide by default, narrowable to one Branch" shape. Inferred, not confirmed —
/// flagged for Architect review.
model Class {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  instructorId String?
  instructor   User?   @relation("ClassInstructor", fields: [instructorId], references: [id])

  /// Phase 5 — set only on a Class materialized by the class-occurrence-generation job
  /// from a recurring TimetableSlot (nullable timetableSlotId, Spec 55 §6.1); null for
  /// an independent one-off Class. occurrenceDate is the date-only companion this pairs
  /// with — together they back the @@unique below, which is what makes the job's
  /// "unless one already exists for that slot+date" behavior an actual DB-level
  /// guarantee rather than an application-level check-then-insert race.
  timetableSlotId String?
  timetableSlot   TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  occurrenceDate  DateTime?      @db.Date

  title       String
  // Cardinality (required, at least one) is an inferred design choice, not stated by
  // §9 — flagged for Architect review same as branchId above.
  activities  String[] @default([])
  bannerUrl   String?
  description String?

  startDate DateTime
  endDate   DateTime

  capacity Int? // nullable = unlimited (confirmed)

  bookingEndAt      DateTime?
  qrAttendanceEndAt DateTime?
  refundFeeDate     DateTime?

  // Minor-unit integer (cents), not Decimal/float — no existing precedent in this schema
  // for a money field; minor-unit integers are consistent with domain-rules §7's existing
  // "rounded once to the currency's minor unit" rule and avoid float-rounding entirely.
  // Flagged for Architect review, same as the other inferred choices on this model.
  cancellationCharge Int?

  termsWaiverRequired Boolean @default(false)
  membershipInclusion Boolean @default(false) // default is opt-out (confirmed §6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 9 — back-relations for MembershipPlan.scopedClassId / Membership.scopedClassId
  // (Spec 55 §6.1: a Class Pack or Friend Pass may restrict itself to one specific
  // Class, e.g. a single ticket to one workshop). Named relations since Class already
  // carries an unrelated named relation to User (ClassInstructor) — Prisma requires
  // an explicit name once a model has more than one relation to resolve ambiguity.
  scopedByMembershipPlans MembershipPlan[] @relation("MembershipPlanScopedClass")
  scopedByMemberships     Membership[]     @relation("MembershipScopedClass")

  // Phase 11 — a Class now has real Bookings/WaitlistEntry rows.
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  // The DB-level guarantee behind "the job never double-materializes the same
  // occurrence" — see the comment on timetableSlotId/occurrenceDate above. Postgres
  // treats NULL as distinct from NULL in a unique constraint, so this imposes no
  // restriction on one-off Classes (timetableSlotId/occurrenceDate both null).
  @@unique([timetableSlotId, occurrenceDate])
  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([timetableSlotId])
  // Phase 14 — AcademiesService.findOne's "upcoming Classes" read range-filters
  // and orders by startDate for a given schoolId; see the Phase 14 migration.
  @@index([schoolId, startDate])
}

/// TimetableSlot (Phase 5, Spec 55 §6.1/§9) — a School's recurring weekly schedule.
/// Confirmed field list (quoted, not paraphrased): "Week day, start time, end time,
/// start break, end break, status (On/Off)." Relations: "Belongs to School (and
/// Instructor, inferred); recurring weekly pattern, not date-specific; has many
/// generated Class occurrences."
///
/// branchId is directly confirmed (not inferred the way Class's was) — Spec 55 §4.3
/// explicitly names TimetableSlot as one of the 4 entities keyed on branch_id for RLS.
/// Nullable for the same reason Class's is: School-wide by default, narrowable to one
/// Branch.
///
/// instructorId gets the same "active INSTRUCTOR RoleGrant holder, not a separate
/// table" treatment as Class's — but Spec 55 itself marks this relation "inferred",
/// not confirmed the way the field list is. Same caution Class's instructorId got in
/// Phase 4, carried forward rather than treated as more settled here.
///
/// Everything below `status` is a Developer-level addition beyond Spec 55's confirmed
/// six fields, resolved directly with the product owner during Phase 5 scoping (record
/// as a Decision, same pattern as Decisions 82-84): the confirmed six give the
/// class-occurrence-generation job nothing it needs to actually build a Class (no
/// title, no activities, no capacity — both of the latter two are required on Class).
/// These are template fields, copied onto every generated Class:
///   - title, activities, capacity, description, bannerUrl, termsWaiverRequired,
///     membershipInclusion — same field names/types/validation constraints as Class's
///     own; CreateTimetableSlotDto's validation MUST mirror CreateClassDto's exactly
///     for each of these, or a TimetableSlot that passes its own looser validation can
///     still fail deep inside the background job when the Class gets created.
///   - bookingCutoffMinutesBeforeStart / qrAttendanceWindowMinutes /
///     refundCutoffHoursBeforeStart — NOT copies of Class's bookingEndAt/
///     qrAttendanceEndAt/refundFeeDate, which are absolute datetimes that don't mean
///     anything on a recurring template. These are durations instead; the job resolves
///     each into a real datetime relative to that specific occurrence's startDate.
///   - cancellationCharge copies straight across unchanged (already a plain amount).
model TimetableSlot {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  instructorId String?
  instructor   User?   @relation("TimetableSlotInstructor", fields: [instructorId], references: [id])

  weekday Weekday

  startTime  DateTime  @db.Time(0)
  endTime    DateTime  @db.Time(0)
  breakStart DateTime? @db.Time(0)
  breakEnd   DateTime? @db.Time(0)

  status TimetableSlotStatus @default(ON)

  // Template fields — copied verbatim onto every generated Class. See the model
  // header comment above for why these exist beyond Spec 55's confirmed six.
  title       String
  activities  String[] @default([])
  capacity    Int?
  description String?
  bannerUrl   String?

  termsWaiverRequired Boolean @default(false)
  membershipInclusion Boolean @default(false)

  // Durations, not absolute dates — resolved per-occurrence by the job. See the model
  // header comment above.
  bookingCutoffMinutesBeforeStart Int?
  qrAttendanceWindowMinutes       Int?
  refundCutoffHoursBeforeStart    Int?
  cancellationCharge              Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedClasses Class[]

  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
  // Phase 14 — AcademiesService.findTimetable's "active slots only" read filters by
  // (schoolId, status); see the Phase 14 migration.
  @@index([schoolId, status])
}

/// Instructor (Phase 6, Spec 55 §6.1) — a profile/bio *extension* for a person who
/// already holds the INSTRUCTOR role, NOT the source of truth for whether they hold it
/// (that stays RoleGrant, checked via TenantAuthorizationService.assertValidInstructor
/// — see the Phase 6 kickoff prompt). Confirmed field list (quoted, not paraphrased):
/// "Name, photo, belt/ranking, specializations (activities), phone, years of
/// experience, bio; linked User account for its own login."
///
/// This does NOT reverse the Phase 4/5 decision that Class.instructorId/
/// TimetableSlot.instructorId stay FKs into User, not this table — "taught by an
/// Instructor" still means "instructorId references a User holding an active
/// INSTRUCTOR RoleGrant", per those models' own comments. Instructor here is never the
/// FK target for instructorId anywhere, and is never itself consulted to answer
/// "does this User hold the Instructor role" — two genuinely separate concerns, kept
/// separate on purpose. Flagged for Architect review since this is new surface area
/// immediately adjacent to that settled decision.
///
/// branchId is directly confirmed, not inferred — Spec 55 explicitly names Instructor
/// (alongside TimetableSlot, Class, Booking) as one of the 4 entities RLS keys on
/// branch_id. Nullable for the same "School-wide by default, narrowable to one Branch"
/// reason Class's/TimetableSlot's own branchId is.
///
/// @@unique is [schoolId, userId], deliberately NOT [schoolId, branchId, userId] — one
/// shared profile row per person per School even though their RoleGrant(s) could in
/// principle be Branch-scoped at more than one Branch of the same School. Flagged for
/// Architect review as an inferred simplification; the confirmed text doesn't settle
/// whether a multi-Branch Instructor needs distinct per-Branch profiles.
model Instructor {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  photoUrl String?

  /// Plain display text, NOT a live reference into StudentRank/Rank — RanksModule
  /// doesn't exist yet, and nothing confirms an Instructor's shown rank must be sourced
  /// from that system rather than self-reported text.
  beltRanking String?

  specializations String[] @default([])

  /// Distinct, optional School-facing contact number — Spec 55 lists `phone` on
  /// Instructor's own entity row, separate from User.phone (the login/OTP number). Not
  /// assumed identical to User.phone without confirmation.
  phone String?

  yearsOfExperience Int?
  bio               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One profile per person per School — see the model header comment above for why
  // this is deliberately not also keyed on branchId.
  @@unique([schoolId, userId])
  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([userId])
}

/// LegalDocument (Phase 7, Spec 55 SettingsModule row) — storage for GET
/// /legal/{doc}. `content` is nullable and starts null for every seeded row — Spec
/// 55's own screen inventory never captured real Terms & Conditions/Privacy
/// Statement text ("Content screens, no CMS fields beyond static text observed"),
/// and that text must come from actual legal/product input, never invented here.
/// No admin-authoring endpoint exists yet (needs Platform Admin auth, §4.4 — not
/// built, see the Phase 7 kickoff prompt) — until then this table can only be
/// populated by a direct DB write/seed, not through the API.
///
/// Why a real table here and not a TS constant like SettingsModule's own
/// languages/currencies lists (constants/languages.ts, constants/currencies.ts)?
/// NOT because this is "a confirmed endpoint and they aren't" — all three are
/// equally confirmed endpoints, and this table is in exactly the same
/// no-confirmed-write-path position they are (caught on code review: an earlier
/// draft of this comment used that reasoning, and it doesn't actually hold up — a
/// migration-seeded INSERT isn't meaningfully more "dynamic" than a TS constant,
/// both need a deploy to change). The real distinguishing factor is content shape
/// and growth direction: `content` is meant to eventually hold arbitrary long-form
/// text authored through a future admin CMS flow — the same category Spec 55
/// explicitly describes TranslationsModule's own content as ("CMS-backed... not
/// static JSON") — where a language/currency list is a small, closed reference set
/// with no comparable long-form-content future. A per-row `updatedAt` and a
/// human-meaningful `slug` primary key are exactly the shape that content
/// eventually wants and a closed reference list doesn't need.
///
/// No RLS — not tenant-scoped data (global, platform-level legal content).
/// Precedent-checked, not just asserted: AdminUser (CREATE TABLE'd in
/// 20260902000000_init but never gets ENABLE ROW LEVEL SECURITY) genuinely
/// establishes that a table with no tenant column can skip RLS in this codebase —
/// but AdminUser has never actually been queried by any service code anywhere in
/// this repo (verified by grep), and its own migration comment says its access "is
/// gated entirely at the application layer via the separate Platform Admin
/// identity realm, which doesn't exist yet." So AdminUser is real precedent for
/// "this table needs no RLS policy" — it is NOT precedent for "query the bare
/// PrismaAppService client directly, bypassing withTenantContext," which
/// SettingsService does here for the first time in this codebase, reasoned
/// correctly from withTenantContext's own implementation (see its call site's own
/// comment), not by following an already-established querying pattern that turns
/// out not to exist.
model LegalDocument {
  /// URL-slug identity, not a UUID — the confirmed route is GET /legal/{doc}, a
  /// human-meaningful key ("terms-and-conditions"), not an opaque id.
  slug String @id

  title   String
  content String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Translation (Phase 49, ultm8-nestjs-module §5) — the CMS-backed i18n content this
/// codebase's own LegalDocument comment (above) already forward-referenced.
/// Confirmed shape: `docs/ultm8-blueprint.html`'s own term glossary states
/// "Translation: Screen · label key · locale · content" — corroborating
/// ultm8-nestjs-module §5's confirmed query params (`GET /translations?locale=&screen=`)
/// and supplying the remaining two fields those params imply.
///
/// No RLS — same precedent as LegalDocument (see that model's own comment for the
/// full AdminUser-precedent reasoning): global, platform-level content, not
/// tenant-scoped data, queried via the plain PrismaAppService/ultm8_app role, no
/// PrismaPlatformAdminService bypass needed for the row itself.
///
/// `id` is a Prisma-client-generated UUID (`@default(uuid())`), not a human-meaningful
/// key like LegalDocument's `slug` — there's no natural single-field identity here the
/// way a legal document's own url slug is one; the real natural key is the
/// (screen, labelKey, locale) triple below, enforced as a unique index rather than as
/// the primary key so callers still address a row by a stable opaque id (matching
/// every other CRUD resource in this codebase).
///
/// `locale` is free text, not an enum against `settings/constants/languages.ts`'s
/// `LANGUAGES` list — same reasoning `UpdateFranchiseDto.defaultLanguage`'s own
/// comment already gives: no canonical language code list is confirmed anywhere yet
/// (domain-rules §1), so this doesn't invent a stricter constraint than the spec
/// itself confirms.
model Translation {
  id String @id @default(uuid())

  screen   String
  labelKey String
  locale   String
  content  String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  /// The natural key implied by the confirmed Translation shape — `content` is the
  /// value, these three are the address. Enforced here, not just at the app layer,
  /// so a raw client can't create a duplicate slot even if TranslationsService's own
  /// check were ever bypassed.
  @@unique([screen, labelKey, locale])
}

/// PaymentAccount (Phase 8, Spec 55 §6.1) — a School's or a Franchise's own Stripe
/// Connect Express account reference (Decision 86,
/// docs/decisions/POST-SPEC-55-DECISION-LOG.md). No raw secret keys are ever stored
/// (§4.5/§10.4) — only the Connected Account id.
///
/// Belongs to School OR Franchise, never both — mirrors the polymorphic-owner shape,
/// not RoleGrant's three-way scope triple (RoleGrant's franchiseId/schoolId/branchId
/// together encode ONE grant's scope; here schoolId/franchiseId are two alternate
/// owners for two structurally separate rows — a School's own PaymentAccount and a
/// Franchise's own PaymentAccount are different rows for different purposes,
/// confirmed: "never a School's PaymentAccount directly" for Franchise-fee income).
/// Enforced BOTH at the application layer (PaymentsService) AND, added on code
/// review, a real DB CHECK constraint (num_nonnulls(schoolId, franchiseId) = 1, in
/// the migration) — an earlier draft left this app-layer-only, reasoning no
/// precedent in this schema covered a multi-column exclusive-OR constraint; given
/// how financially load-bearing this table is, the migration's own comment explains
/// why that reasoning didn't hold up for this specific table.
///
/// The Franchise side is schema-correct but practically unreachable this phase — no
/// FranchisesController/FranchisesService exists anywhere in this codebase yet
/// (Phase 2 deliberately deferred Franchise CRUD), and FRANCHISE_OWNER is
/// deliberately excluded from GrantableRoleDto (see its own header comment) — there
/// is no self-service way for anyone to hold a FRANCHISE_OWNER grant in this product
/// today. See the Phase 8 kickoff prompt for the full reasoning.
model PaymentAccount {
  id String @id @default(uuid())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  provider     PaymentAccountProvider
  accountTitle String
  country      String
  status       PaymentAccountStatus   @default(ACTIVE)
  mode         PaymentAccountMode     @default(TEST)

  /// Never a raw secret key (Decision, existing, §4.5/§10.4). Null until Stripe
  /// Connect onboarding is initiated — set synchronously in
  /// PaymentsService.initiateConnectOnboarding() from Stripe's own accounts.create()
  /// response, NOT by a webhook handler. (Corrected from an earlier draft of this
  /// comment, which assumed the id itself arrived via the account.updated webhook —
  /// checked directly against Stripe's own API shape before writing the service
  /// method: accounts.create() returns the new Connected Account's id synchronously,
  /// no webhook needed for that specific value. See that method's own comment.)
  stripeConnectedAccountId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions        Transaction[]
  franchiseFeeCharges FranchiseFeeCharge[]

  // One PaymentAccount per School, one per Franchise — "has one PaymentAccount set"
  // (School's and Franchise's own confirmed entity rows, singular).
  @@unique([schoolId])
  @@unique([franchiseId])
}

/// ProcessedStripeEvent (Phase 8) — Stripe webhook idempotency ledger. Spec 55 §10.2's
/// own confirmed idempotency mechanism: "idempotency is enforced by deduping on
/// Stripe's event id before processing, since Stripe may redeliver the same webhook
/// more than once." A Postgres row, not a BullMQ jobId-based dedup or an in-memory
/// set — checked directly, not assumed: BullMQ's own completed-job retention is
/// bounded (removeOnComplete-style pruning) and reset on every deploy, whereas Stripe
/// can redeliver a webhook well after a completed job would have been pruned; this
/// needs a durable, permanent record, the same reasoning that already put
/// class-occurrence-generation's own idempotency guarantee at the database level
/// (its @@unique on timetableSlotId/occurrenceDate) rather than in application memory.
/// This is a new pattern for webhook-specific idempotency in this codebase — flagged
/// as such, not presented as following an existing precedent that doesn't exist.
///
/// No RLS — not tenant-scoped data (a platform-level operational ledger, same
/// category as AdminUser/LegalDocument, which also carry none).
model ProcessedStripeEvent {
  /// Stripe's own event id (e.g. "evt_...") — the de-dup key itself, not a
  /// separately-generated UUID.
  stripeEventId String @id

  eventType String

  processedAt DateTime @default(now())
}

/// MembershipPlan (Phase 9, Spec 55 §6.1) — School↔Student billing (never confused
/// with the platform↔Franchise/School `SubscriptionPlan`, domain-rules §15). Belongs
/// to School only — Spec 55 never gives this a Franchise side, unlike PaymentAccount.
///
/// Confirmed fields (quoted): "Title, type... price (fixed at 0 for Friend Pass),
/// expiry... classes included... scoped Class... visibility (Public), refund-fee
/// date, cancellation charge, terms/waiver-required flag; requires Stripe as the
/// payment method when type=Subscription."
///
/// `price` is a minor-unit Int, matching Class.cancellationCharge's own established
/// convention — no Decimal/float anywhere in this schema for money.
///
/// `currency` is a plain String?, matching User.currency/School.defaultCurrency's own
/// convention (Decision 7, Spec 55 §11.2 — MembershipPlan pricing stays independent
/// per-currency, School-set, with NO automatic conversion across the 6 supported
/// currencies) — not a new Currency enum.
///
/// `expiryDurationDays` is a Developer-level inferred column, not a literally-named
/// field from Spec 55 (which only describes behavior: "the plan's default
/// duration/credit rule — used to compute each Membership's actual expiry date...
/// at the moment the Membership is created"). Flagged for an explicit Decision entry
/// in docs/decisions/POST-SPEC-55-DECISION-LOG.md before this is treated as settled —
/// same "Developer-level addition... resolved directly with the product owner"
/// treatment TimetableSlot's own template fields got in Phase 5. Null for
/// WEEKLY_PASS, which Spec 55 separately says computes from "its own date window
/// rather than credit-based."
///
/// `visible` models "visibility (Public)" as a boolean — Spec 55 never names a second
/// value opposite "Public", so a toggle (matching this schema's own Boolean-flag
/// convention elsewhere, e.g. Class.termsWaiverRequired) is the literal reading, not
/// a guessed enum with invented values.
///
/// Payment-method enforcement (type=SUBSCRIPTION requires Stripe) is NOT a column on
/// this model — School's PaymentAccount is one row with one fixed `provider`
/// (Phase 8's own @@unique([schoolId]) — a School cannot hold both a Stripe AND a
/// Cash/Bank PaymentAccount simultaneously), so the actual payment method for any
/// purchase is derived from the School's single configured PaymentAccount.provider
/// at purchase time (MembershipsService.purchase()), not chosen per-purchase by the
/// client. A School whose PaymentAccount.provider isn't STRIPE simply cannot sell a
/// SUBSCRIPTION-type plan — enforced in the service layer, not schema-level, since it
/// depends on a sibling row's own field, not a static constraint.
model MembershipPlan {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  type  MembershipPlanType
  title String

  price    Int // minor-unit; fixed at 0 for FRIEND_PASS (validated in the DTO/service layer)
  currency String?

  expiryDurationDays Int? // see header comment — inferred, needs a Decision entry

  // Class Pack / Friend Pass only. Capped at 1 when scopedClassId is set (a one-off
  // Class has only one occurrence — additional credits could never be spent,
  // stranding prepaid credit, Spec 55 §6.1) — validated in the service layer.
  classesIncluded Int?

  scopedClassId String?
  scopedClass   Class?  @relation("MembershipPlanScopedClass", fields: [scopedClassId], references: [id])

  visible Boolean @default(true)

  refundFeeDate       DateTime?
  cancellationCharge  Int?
  termsWaiverRequired Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  transactions Transaction[]

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([scopedClassId])
}

/// Membership (Phase 9, Spec 55 §6.1) — a Student's purchased instance of a
/// MembershipPlan. `status` is Active/Expired ONLY (Decision 6 — see MembershipStatus's
/// own comment); a row is created, not status-flipped, at the moment its payment
/// settles. See the Phase 9 kickoff prompt §2.1 for the full creation-timing state
/// machine (Stripe payment_intent.succeeded / Cash-Bank PATCH .../confirm / £0-plan
/// immediate).
///
/// `schoolId` is denormalized from `membershipPlan.schoolId` — same reasoning
/// Booking.branch_id is denormalized from Class.branchId in Spec 55 §6.1
/// ("enables Branch Staff row-level scoping... without a join through Class"): keeps
/// this row's own RLS policy a direct column comparison rather than a join through
/// MembershipPlan. Set once at creation, never updated (a Membership's School never
/// changes after purchase).
///
/// `stripeSubscriptionId` correlates `customer.subscription.updated/deleted` webhook
/// events back to this row for SUBSCRIPTION-type Memberships only — not a Spec 55-
/// named column, but required for the webhook processor to find which Membership a
/// subscription-lifecycle event concerns; flagged as a Developer-level addition, same
/// class as `expiryDurationDays` above.
model Membership {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("MembershipStudent", fields: [studentId], references: [id])

  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  // Denormalized from membershipPlan.schoolId — see header comment.
  schoolId String

  status    MembershipStatus    @default(ACTIVE)
  startDate DateTime            @default(now())
  frequency MembershipFrequency

  // Class Pack / Friend Pass only — decremented at Booking creation (Phase 11 scope;
  // this phase only sets the initial value from MembershipPlan.classesIncluded).
  classesRemaining Int?

  expiryDate DateTime?

  // Inherited from MembershipPlan when it names one (Spec 55 §6.1) — restricts which
  // Class this Membership can book. Set once at creation from membershipPlan.scopedClassId.
  scopedClassId String?
  scopedClass   Class?  @relation("MembershipScopedClass", fields: [scopedClassId], references: [id])

  // Friend Pass only — distinguishes a School comp from a paid purchase.
  giftedById String?
  giftedBy   User?   @relation("MembershipGiftedBy", fields: [giftedById], references: [id])

  stripeSubscriptionId String? @unique // see header comment; SUBSCRIPTION-type only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // Phase 11 — this Membership's credit can fund the Student's own seat on a
  // Booking (sourceMembershipId) or a guest's seat via BookingAttendee.
  bookingsAsSource Booking[]         @relation("BookingSourceMembership")
  bookingAttendees BookingAttendee[] @relation("BookingAttendeeMembership")

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([studentId])
  @@index([membershipPlanId])
}

/// Transaction (Phase 9, Spec 55 §6.1) — "The per-charge ledger record for
/// Student-to-School payments (Membership purchases)." No separate "invoice id"
/// column — this row's own `id` serves that purpose (matching every other model's
/// convention in this schema; nothing distinguishes an "invoice id" from the row
/// identity itself anywhere in Spec 55's text).
///
/// A Transaction row is NOT created for the £0-immediate-Active purchase path
/// (Spec 55 §6.1: "any Cash/Bank-eligible plan priced at 0... with no Transaction or
/// wait at all"). For every other path (Stripe one-time/Subscription, Cash/Bank
/// Transfer), a Transaction is created synchronously at purchase time with status
/// PENDING — this reading is the Phase 9 kickoff prompt's own resolution of a real
/// ambiguity in Spec 55's text (§7's endpoint description names the Transaction-at-
/// purchase-time behavior only for the Cash/Bank case in its own sentence, but §6.1's
/// TransactionStatus enum explicitly includes PENDING and FAILED as real states a
/// Stripe-paid Transaction can reach, and confirms "the Transaction also references
/// the resulting Membership" without qualifying that to Cash/Bank only) — see
/// MembershipsService.purchase()'s own comment for the full reasoning trail.
///
/// `paymentMethod` reuses PaymentAccountProvider directly (see that enum's own
/// comment) — copied from the School's own PaymentAccount.provider at purchase time,
/// never chosen independently per-purchase (a School has exactly one PaymentAccount,
/// Phase 8's own @@unique([schoolId])).
///
/// `stripePaymentIntentId` correlates `payment_intent.succeeded/failed` webhook
/// events back to this row — not a Spec 55-named column, but required for the
/// webhook processor to find which Transaction a payment event concerns; same
/// Developer-level-addition class as Membership.stripeSubscriptionId above.
model Transaction {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  studentId String
  student   User   @relation("TransactionPayer", fields: [studentId], references: [id])

  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])

  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  // Set once payment settles and the Membership is created (Spec 55 §6.1) — null
  // until then.
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  billingDate DateTime @default(now())
  amount      Int // minor-unit, same convention as MembershipPlan.price
  currency    String?

  status        TransactionStatus
  paymentMethod PaymentAccountProvider

  // Only ever reachable for Stripe-paid Transactions (Decision 55) — Cash/Bank rows
  // have no Stripe charge id to match. No Phase 9 code path sets this (out of scope
  // — see the Phase 9 kickoff prompt §3); modeled for schema completeness only.
  disputedAmount Int?

  // Cumulative across possibly-multiple partial refunds against the same Transaction
  // (Spec 55 §6.1). No Phase 9 code path sets this (refund isn't buildable yet —
  // needs Booking); modeled for schema completeness only, always null this phase.
  refundedAmount Int?

  stripePaymentIntentId String? @unique // see header comment; Stripe-paid only

  /// Carries the Stripe Subscription id from MembershipsService.purchase() (where
  /// it's returned synchronously by PaymentsService.subscribe()) through to the
  /// stripe-webhook-processing job's payment_intent.succeeded handler, which copies
  /// it onto the Membership row it creates — Membership doesn't exist yet at
  /// purchase time (Decision 6), so this is the only place to stash it in the
  /// interim. SUBSCRIPTION-type purchases only; not unique itself (unlike
  /// Membership.stripeSubscriptionId) since nothing looks a Transaction up by it.
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([studentId])
  @@index([membershipPlanId])
}

/// FranchiseFeeCharge (Phase 16b-ii, Spec 55 §6.1/§10.2) — the per-billing-cycle
/// ledger record for a School->Franchise franchise-fee charge, a wholly separate
/// payment relationship from Transaction (Student->School) and PlatformCharge
/// (School/Franchise->ULTM8) — never conflate the three (domain-rules §2).
///
/// Confirmed field list (quoted, not paraphrased): "Franchise, School, billing
/// period, fee basis snapshot (Flat or Per-Headcount, copied from
/// Franchise.feeModel at charge time so a later feeModel change never rewrites
/// history), computed amount, currency, active-student-count snapshot
/// (Per-Headcount only, captured at charge time), Stripe PaymentIntent/Invoice id,
/// status (Successful/Pending/Failed/Refunded/Disputed — same enum as
/// Transaction), refundedAmount (nullable, cumulative), disputedAmount (nullable,
/// taken straight from the Stripe dispute event payload)."
///
/// `status` reuses TransactionStatus directly (spec's own words: "same enum as
/// Transaction") rather than a second identical enum — same reuse convention
/// PaymentAccountProvider already established for Transaction.paymentMethod.
///
/// `franchisePaymentAccountId` — spec says this entity "references both parties'
/// PaymentAccount". Modeled as a single explicit FK to the Franchise's own
/// PaymentAccount (the payee/destination) only, mirroring Transaction's own
/// `paymentAccountId` shape exactly (that field is also only ever the payee's
/// account — a Student has no PaymentAccount of their own either). The School
/// (payer) side is NOT a second FK to a School PaymentAccount: the School's own
/// PaymentAccount (if it has one) is a wholly separate Stripe Connect account
/// used for its OWN Student->School billing, and a franchise-fee charge is paid
/// via a Stripe Customer+PaymentMethod created ON the Franchise's connected
/// account instead (PaymentsService.ensureFranchiseFeeSubscription) — the same
/// "throwaway Customer scoped to the payee's own connected account" pattern
/// MembershipsService.subscribe() already established for Student->School, here
/// applied School->Franchise instead. Developer-level interpretation of an
/// otherwise-ambiguous spec phrase, flagged for Architect review.
///
/// `currency` is always 'USD', set in code, never read from a per-Franchise
/// field — domain-rules §11.2/Decision 7 confirms Franchise-fee is billed in a
/// single anchor currency, unlike MembershipPlan's genuinely per-currency
/// pricing. Stored per-row anyway (nullable String, matching Transaction's own
/// convention) rather than omitted, since the confirmed field list names it
/// explicitly and PlatformCharge's own sibling entity does the same.
///
/// `billingPeriodStart`/`billingPeriodEnd` model "billing period" as an explicit
/// date range rather than a single label — the natural reading for a recurring
/// monthly charge, and needed by the franchise-fee-usage-reporting job to know
/// which month's active-student-count a given Per-Headcount row snapshots.
///
/// One row is created per billing cycle (NOT once per School<->Franchise
/// relationship, unlike Membership) — a genuinely different creation-timing
/// shape from every other billing entity in this schema so far. See
/// PaymentsService.ensureFranchiseFeeSubscription and the
/// franchise-fee-usage-reporting job/stripe-webhook-processing's own new
/// invoice.paid/invoice.payment_failed handlers for the full creation-timing
/// account: a Per-Headcount row is created PENDING by the monthly usage-report
/// job (which knows the activeStudentCountSnapshot value at that moment); a Flat
/// row has no snapshot to capture in advance and is instead created directly,
/// already Successful, by the invoice.paid webhook handler.
model FranchiseFeeCharge {
  id String @id @default(uuid())

  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  franchisePaymentAccountId String
  franchisePaymentAccount   PaymentAccount @relation(fields: [franchisePaymentAccountId], references: [id])

  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  feeBasisSnapshot FeeModel
  amount           Int // minor-unit, same convention as Transaction.amount
  currency         String? // always 'USD' in practice — see header comment

  // Per-Headcount only — the active-student-count reported to Stripe for this
  // billing period. Null for a Flat-fee row.
  activeStudentCountSnapshot Int?

  status TransactionStatus // reused directly — spec's own "same enum as Transaction"

  stripeInvoiceId      String? @unique
  stripeSubscriptionId String?

  // Cumulative across possibly-multiple partial refunds against the same charge,
  // same convention as Transaction.refundedAmount. Set by
  // FranchiseFeeChargesService.refund() (Franchise Owner only, Spec 55 §10.2 —
  // the Franchise's own PaymentAccount holds the money, so the Franchise, not the
  // paying School, is the party who'd issue it back).
  refundedAmount Int?

  // Only ever reachable for a disputed charge (Decision 55's dispute handling) —
  // no code path sets this yet, same "modeled for schema completeness only"
  // treatment Transaction.disputedAmount got in Phase 9.
  disputedAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes leading with the tenant column (Decision 30) — this entity
  // has two tenant sides (Franchise the payee, School the payer), so both get one.
  @@index([franchiseId])
  @@index([schoolId])
  // Matches franchise-fee-usage-reporting.processor.ts's and stripe-webhook-
  // processing.processor.ts's own (stripeSubscriptionId, status) query shape —
  // see the migration's own comment. The companion partial unique index
  // enforcing "one charge row per (subscription, billing period)" is NOT
  // representable here — Prisma's schema DSL has no partial/filtered unique
  // index support, same established limitation as every other partial unique
  // index in this schema (Membership_one_active_general_access_per_school and
  // siblings) — it exists only in the migration's own hand-authored SQL.
  @@index([stripeSubscriptionId, status])
}

/// PromotionEvent.type — Phase 10b. Confirmed field (skills/ultm8-domain-rules/
/// SKILL.md §5, quoted): "types: Promotion / Downgrade / Bulk Promotion / Bulk
/// Stripe Award / Stripe Award." The two BULK_* values exist in this enum even
/// though this phase's own endpoints defer the bulk ACTIONS themselves (Phase 10b
/// kickoff prompt §1.d) — the historical record shape should accommodate them for
/// whenever a follow-up phase adds the bulk endpoints, not need a later migration
/// to add enum values.
enum PromotionEventType {
  PROMOTION
  DOWNGRADE
  STRIPE_AWARD
  BULK_PROMOTION
  BULK_STRIPE_AWARD
}

/// StudentRank per-skill sign-off status. Confirmed field (SKILL.md §5, quoted):
/// "per-skill sign-off status (Not Started / Learning / Signed Off)... scoped to
/// the current checkpoint only." The exact cycle behavior a PATCH endpoint uses to
/// step through these three values is not itself specified — the Phase 10b kickoff
/// prompt's own §3.2 flags a 3-state wrap (NOT_STARTED -> LEARNING -> SIGNED_OFF ->
/// NOT_STARTED) as the reading proceeded on, not asserted as settled fact.
enum SkillSignOffStatus {
  NOT_STARTED
  LEARNING
  SIGNED_OFF
}

/// Discipline (Phase 10b, Spec 55 §4/§5/§6.1) — belongs to School; owns an ordered
/// ladder of Ranks. Confirmed field-model structure per the working, tested
/// grading-system prototype (§2.3), not a Figma-only inference: "A discipline is
/// formally backed by a Style/Discipline entity (name, class types offered)
/// belonging to a School, owning an ordered ladder of Ranks."
///
/// RECONCILIATION NOTE, flagged not resolved (SKILL.md §4): School.activities /
/// Instructor.specializations / Class.activities and this Discipline entity are
/// "not formally reconciled" into one controlled list. Deliberately kept as its
/// own new entity here, matching the working prototype's own validated shape —
/// not unified with the other three as a guess. Flag for Architect review.
model Discipline {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name              String
  classTypesOffered String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ranks        Rank[]
  skills       Skill[]
  studentRanks StudentRank[]

  @@index([schoolId])
}

/// Rank (Phase 10b, Spec 55 §5/§6.1) — belongs to Discipline; ordered ladder
/// position. Confirmed fields (quoted): "primary belt colour and an optional
/// secondary colour (two-colour belts), a weekly class-count cap, a set of
/// required Skills, and a years-in-rank flag."
///
/// `yearsInRankFlag` is a genuine Boolean only — Spec 55's own literal field list
/// ("years-in-rank flag (Black Belt and above)") never names a separate numeric
/// field for HOW MANY years are required, and no confirmed mechanism exists
/// anywhere for the actual threshold or where it would be configured. Storing and
/// toggling the flag is all this phase does — nothing enforces real tenure yet.
/// Do not invent a `yearsRequired: Int` field or a default number (Phase 10b
/// kickoff prompt §3.1) — flagged for the Architect/product owner, not guessed.
model Rank {
  id String @id @default(uuid())

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  // Denormalized from discipline.schoolId — same reasoning every other
  // RLS-scoped child table in this schema already uses (Membership.schoolId,
  // Transaction.schoolId — verified against this repo's own merged Phase 9
  // migration, not just recalled), doubly necessary here: without it, Rank's own
  // RLS policy would need a two-hop join through Discipline just to reach
  // RoleGrant, and RankStripeTier (Rank's own child) would need three. Decision
  // 30's own "composite index leading with the tenant column" principle assumes
  // a direct tenant column exists on every RLS-scoped table, not a multi-hop path
  // to one.
  schoolId String

  order Int

  primaryColour   String
  secondaryColour String?

  weeklyClassCountCap Int?
  yearsInRankFlag     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeTiers RankStripeTier[]

  requiredSkills RankRequiredSkill[]

  studentRanksCurrent StudentRank[]    @relation("StudentRankCurrentRank")
  promotionEventsFrom PromotionEvent[] @relation("PromotionEventFromRank")
  promotionEventsTo   PromotionEvent[] @relation("PromotionEventToRank")

  @@unique([disciplineId, order])
  @@index([schoolId])
  @@index([disciplineId])
}

/// RankStripeTier (Phase 10b, Spec 55 §5/§6.1) — belongs to Rank. Confirmed: "each
/// stripe tier has its own stable id..., its own count, its own colour, its own
/// classes-required and minimum-days-in-rank thresholds, and its own
/// eligibleClassTypes list." The `id` (uuid, not a positional index) IS the stable
/// id §5 requires — "so reordering tiers can't break references."
model RankStripeTier {
  id String @id @default(uuid())

  rankId String
  rank   Rank   @relation(fields: [rankId], references: [id])

  // Denormalized from rank.schoolId — see Rank's own comment for the full
  // "avoid a multi-hop RLS join" reasoning, doubly true here (three hops from
  // School otherwise: School -> Discipline -> Rank -> RankStripeTier).
  schoolId String

  order Int

  count              Int
  colour             String
  classesRequired    Int?
  minimumDaysInRank  Int?
  eligibleClassTypes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentRanksCurrentStripe StudentRank[]    @relation("StudentRankCurrentStripe")
  promotionEventsFrom       PromotionEvent[] @relation("PromotionEventFromStripeTier")
  promotionEventsTo         PromotionEvent[] @relation("PromotionEventToStripeTier")

  @@unique([rankId, order])
  @@index([schoolId])
  @@index([rankId])
}

/// Skill (Phase 10b, Spec 55 §5/§6.1) — belongs to Discipline. Confirmed fields:
/// "name, description." Many-to-many with Rank (required-skills gate) and, as of
/// Phase 44 (CurriculumModule, Decision 58), many-to-many with Lesson too — Spec
/// 55 §6.1 says "linked skill(s)" (plural) on Lesson's own side, so this is a real
/// M2M via LessonSkill below, not the single skillId FK an earlier draft of this
/// comment anticipated.
model Skill {
  id String @id @default(uuid())

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  // Denormalized from discipline.schoolId — same reasoning Rank/RankStripeTier
  // above.
  schoolId String

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredByRanks      RankRequiredSkill[]
  studentSkillStatuses StudentRankSkillStatus[]
  lessons              LessonSkill[]

  @@index([schoolId])
  @@index([disciplineId])
}

/// RankRequiredSkill — explicit join table for Rank's many-to-many "required
/// Skills" gate (§5). Explicit rather than an implicit Prisma many-to-many —
/// matches this schema's own established convention (every relation elsewhere in
/// this codebase is an explicit model, and hand-authoring Prisma's undocumented
/// implicit-join-table SQL correctly without a live `prisma migrate dev` run to
/// verify against would be needless risk for zero benefit over an explicit one).
model RankRequiredSkill {
  rankId  String
  rank    Rank   @relation(fields: [rankId], references: [id])
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([rankId, skillId])
  @@index([skillId])
}

enum LessonFormat {
  PRERECORDED
  LIVE
}

enum CaptionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Lesson (Phase 44, Decision 58 — Spec 55 §6.1/§7, CurriculumModule). Confirmed
/// fields (quoted): "Title, category, duration, instructor, description, linked
/// skill(s), format (Prerecorded/Live), videoRef, captionStatus
/// (Pending/Processing/Ready/Failed), captionTrackRef." Links to one or more
/// Skills via LessonSkill below (a real M2M — "linked skill(s)" is plural).
///
/// Scoping/authorship: Decision 58's own prose ("an instructor uploads") and Spec
/// 55's own §7 endpoint table (`CRUD /admin/curriculum/lessons`, which per this
/// project's own /admin/* == Platform-Admin-realm convention, ultm8-nestjs-module
/// §5, would mean Platform-Admin-authored) directly contradict each other — a real
/// gap inside Spec 55 itself, not resolved by picking whichever reading was found
/// first. Resolved DIRECTLY WITH THE USER (Decision 104,
/// docs/decisions/POST-SPEC-55-DECISION-LOG.md): School-scoped, Instructor/Staff-
/// authored, ordinary tenant endpoints — same shape as every other content entity
/// in this schema (Class, Waiver, MembershipPlan, ...), not the Platform Admin
/// realm.
///
/// [UNRESOLVED, deliberately not modeled] Spec 55's own field row also says Lesson
/// "Belongs to a Category" — no Category entity exists anywhere else in the
/// document (verified directly against the extracted spec text: the word
/// "Category" occurs exactly once in the whole document, this one relationship
/// clause, one line below `category` used as a plain field). Treated as a spec
/// doc-bug, not built as a relation — `category` below is a plain string only.
/// Flag to the Architect before ever promoting this to a real model.
///
/// `instructorId` mirrors Class.instructorId's own established shape exactly (a
/// User holding an active INSTRUCTOR RoleGrant at this School, validated via
/// TenantAuthorizationService.assertValidInstructor — never a separate
/// Instructor-profile FK, per that method's own header comment) — reused, not
/// reinvented.
///
/// `videoRef`/`captionTrackRef` are deliberately vendor-agnostic opaque strings,
/// not shaped around Cloudflare Stream specifically — Decision 101 (15 Sep 2026)
/// picked that vendor (+ AWS Transcribe for captioning) but explicitly does not
/// build the integration itself; no credentials for either are provisioned in this
/// working environment, matching every other unprovisioned vendor in this codebase
/// (Stripe/Cognito/R2/Twilio's own precedent) — the actual upload/dispatch calls
/// are still unbuilt.
model Lesson {
  id String @id @default(uuid())

  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id])
  instructorId String?
  instructor   User?   @relation("LessonInstructor", fields: [instructorId], references: [id])

  title           String
  category        String?
  durationSeconds Int?
  description     String?
  format          LessonFormat

  videoRef        String?
  captionStatus   CaptionStatus @default(PENDING)
  captionTrackRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills LessonSkill[]

  @@index([schoolId])
  @@index([instructorId])
}

/// LessonSkill — the confirmed Lesson<->Skill many-to-many ("linked skill(s)",
/// plural, Spec 55 §6.1). Explicit join table, same convention as
/// RankRequiredSkill above (no implicit Prisma many-to-many anywhere in this
/// codebase, by deliberate choice — see that model's own comment). No schoolId of
/// its own — RLS delegates entirely to Lesson/Skill's own policies via the FK join,
/// same reasoning as RankRequiredSkill's own migration comment: this table carries
/// no queryable data beyond the two FKs, so a caller can only ever reach a row here
/// by already having Lesson/Skill visibility.
model LessonSkill {
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id])

  @@id([lessonId, skillId])
  @@index([skillId])
}

/// StudentRank (Phase 10b, Spec 55 §5/§6.1) — belongs to Student; one row per
/// Discipline the Student trains in. Confirmed fields (quoted): "current Rank,
/// currentStripe..., date of current rank, classes attended toward next
/// stripe/rank..., per-skill sign-off status..., and a computed (not stored)
/// readiness bucket... plus a computed progress %."
///
/// Readiness bucket / progress % are deliberately NOT stored or computed anywhere
/// in this phase — Decision 75 confirms only that the formula/thresholds are
/// School-configurable per discipline; "the configuration schema itself is still
/// undesigned." GET /students/{id}/eligibility returns the raw fields below only.
///
/// RLS shape: the SAME narrow "School Owner/Manager, or the row's own Student,
/// nobody else" shape Phase 9 uses for Membership/Transaction (verified against
/// this repo's own merged migration) and Phase 10's WaiversModule applies the
/// same way for WaiverSignature (PR #7 — not yet merged as of this branch, cited
/// for the reasoning trail, not as an in-repo artifact this branch can itself
/// verify) — resolved (not left open) as a direct product decision, recorded as
/// Decision 88, docs/decisions/POST-SPEC-55-DECISION-LOG.md: this is one
/// specific Student's own record (classesAttendedTowardCheckpoint, skill sign-off
/// status), not School-wide catalog data. Staff functional access (Instructors
/// need to check rank for class eligibility, the Grading Board) is preserved via
/// TenantAuthorizationService.assertStaffAtSchool() + running the read under the
/// TARGET Student's own tenant context — the exact mechanism Phase 9 already
/// built for GET /students/{id}/membership-status — not by broadening this policy.
model StudentRank {
  id String @id @default(uuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])

  schoolId String

  currentRankId String
  currentRank   Rank   @relation("StudentRankCurrentRank", fields: [currentRankId], references: [id])

  currentStripeId String?
  currentStripe   RankStripeTier? @relation("StudentRankCurrentStripe", fields: [currentStripeId], references: [id])

  dateOfCurrentRank DateTime @default(now())

  classesAttendedTowardCheckpoint Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillStatuses   StudentRankSkillStatus[]
  promotionEvents PromotionEvent[]

  @@unique([studentId, disciplineId])
  @@index([schoolId])
  @@index([studentId])
  @@index([disciplineId])
}

/// StudentRankSkillStatus — join table carrying StudentRank's per-skill sign-off
/// status (see StudentRank's own header comment for the confirmed field this
/// backs). Scoped to the CURRENT checkpoint only (§5, quoted) — a Promotion or
/// Downgrade DELETES every row here for the affected StudentRank before setting
/// the new currentRank/currentStripe (enforced in the service layer, not a DB
/// trigger), since a prior checkpoint's sign-off status has no confirmed meaning
/// once the checkpoint itself has changed.
model StudentRankSkillStatus {
  id String @id @default(uuid())

  studentRankId String
  studentRank   StudentRank @relation(fields: [studentRankId], references: [id])

  // Denormalized from studentRank.schoolId/studentId — same "avoid a join for
  // RLS" reasoning as Rank/RankStripeTier/Skill above; this table needs the SAME
  // narrow School-Owner-or-self shape StudentRank itself uses (it's the same
  // Student's own personal grading data), not a different one.
  schoolId  String
  studentId String

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  status SkillSignOffStatus @default(NOT_STARTED)

  updatedAt DateTime @updatedAt

  @@unique([studentRankId, skillId])
  @@index([schoolId])
  @@index([studentId])
  @@index([studentRankId])
}

/// PromotionEvent (Phase 10b, Spec 55 §5/§6.1) — the auditable rank-history
/// record. Confirmed (quoted): "A PromotionEvent... is never created by the
/// system on its own" (always coach-initiated); "grading is permitted even when a
/// required skill isn't yet signed off, but only behind an explicit, always-
/// recorded written acknowledgement flag." The from-/to- field pairs below record
/// the actual before/after state — a STRIPE_AWARD leaves fromRankId equal to
/// toRankId (only the stripe tier changes); PROMOTION/DOWNGRADE change both.
model PromotionEvent {
  id String @id @default(uuid())

  studentRankId String
  studentRank   StudentRank @relation(fields: [studentRankId], references: [id])

  // Denormalized from studentRank.schoolId/studentId — see
  // StudentRankSkillStatus's own comment for the reasoning; PromotionEvent is
  // the same class of "one specific Student's own record" (an audit trail of
  // THEIR grading history) as StudentRank itself.
  schoolId  String
  studentId String

  type PromotionEventType

  performedById String
  performedBy   User   @relation("PromotionEventPerformedBy", fields: [performedById], references: [id])

  fromRankId String?
  fromRank   Rank?   @relation("PromotionEventFromRank", fields: [fromRankId], references: [id])
  toRankId   String?
  toRank     Rank?   @relation("PromotionEventToRank", fields: [toRankId], references: [id])

  fromStripeTierId String?
  fromStripeTier   RankStripeTier? @relation("PromotionEventFromStripeTier", fields: [fromStripeTierId], references: [id])
  toStripeTierId   String?
  toStripeTier     RankStripeTier? @relation("PromotionEventToStripeTier", fields: [toStripeTierId], references: [id])

  acknowledgedWithoutSkillSignoff Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([studentRankId])
}

enum WaiverSignatureStatus {
  SIGNED
  UNSIGNED
  EXPIRED
  PENDING
}

/// Waiver (Phase 10, Spec 55 §6.1/§13) — belongs to School; has many
/// WaiverSignatures. Confirmed fields (quoted): "title, body text, per-school
/// assignment."
///
/// "Per-school assignment" is read here as structural (this Waiver belongs to this
/// School, via `schoolId`) rather than a distinct assignment action/entity — no
/// separate "WaiverAssignment" concept is named anywhere in Spec 55's confirmed
/// §6.1 field list, and WaiverSignature already belongs directly to both Waiver and
/// Student. Flagged as the more literal reading, not asserted as definitively
/// settled — see the Phase 10 kickoff prompt §2.1 for the full reasoning trail.
model Waiver {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  title String
  body  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatures WaiverSignature[]

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
}

/// WaiverSignature (Phase 10, Spec 55 §2.2/§6.1/§13; drawn-signature capture added
/// Phase 34) — belongs to Waiver and Student. Confirmed fields (quoted): "signer
/// full name, signature, signed date, status." `signatureText` models the
/// CONFIRMED baseline e-signature mechanism — "a typed full name plus a signature
/// field" (§2.2). `signatureImageKey` is Decision 74/78's drawn-signature-capture
/// upgrade (legally confirmed sufficient by Decision 78; the engineering
/// follow-up — raster vs. vector storage, the schema field itself — was left
/// explicitly open by Decision 74 and resolved here, Phase 34): raster (PNG),
/// not vector/stroke-path data — matches how virtually every production
/// signature-pad capture works (a canvas's own toDataURL() output), directly
/// displayable as an image with no custom renderer needed, and Spec 55 §11.3
/// already classifies this exact asset category ("signed-waiver and invoice
/// PDFs... served from R2 directly, no transformation needed") by the same
/// "legal record, not a resizable gallery asset" reasoning this applies to a
/// signature image. Nullable — a signature may still be Signed via typed-name
/// only if the drawn-capture step was never completed, preserving the existing
/// baseline mechanism rather than making drawn capture mandatory (not itself
/// confirmed anywhere as required). Stores the R2 OBJECT KEY, not a public URL —
/// see R2ClientService's own header comment for why every read of this image
/// goes through a freshly-generated, short-lived presigned URL instead.
///
/// RLS shape: deliberately the SAME narrow "School Owner/Manager, or the row's own
/// Student, nobody else" shape Membership/Transaction use (Phase 9) — NOT the
/// broader "any active RoleGrant holder at the School" shape Class/TimetableSlot/
/// Waiver (the catalog document, above) use. A signed waiver is one specific
/// Student's own legal record, the same class of "not School-wide catalog data"
/// concern Phase 9's own review found the hard way for Membership/Transaction.
/// Spec 55 doesn't state an explicit "no raw row access" rule for WaiverSignature
/// the way it does for Membership/Transaction (§8.2) — the absence of an explicit
/// rule isn't confirmation that broad access is fine, so this picks the safer
/// default and flags it for Architect confirmation rather than silently choosing
/// the broader shape. See the migration's own RLS policy comment for the concrete
/// policy this produces.
///
/// Phase 37 added `signedById` — the actual signer, which diverges from
/// `studentId` (whose waiver this is) once Guardian-on-behalf-of signing
/// (SKILL.md §14, [CONFIRMED]) is possible. RLS is UNCHANGED — every write
/// still runs under `withTenantContext(studentId, ...)` (the row's own
/// "self" branch above), the same target-tenant-context substitution
/// Booking's own Staff-on-behalf-of write already established, so a
/// Guardian caller never needs a new RLS branch of their own. See
/// WaiversService.sign()'s own header comment for the authorization check
/// (GuardianLink, not RoleGrant) and the known limitation this surfaced:
/// there is still no Guardian-on-behalf-of ENROLLMENT path (School's own
/// `join()` is self-service-only), so this is only exercisable once a
/// minor already holds a STUDENT RoleGrant by some other means — a
/// separate, not-yet-built gap, not one this phase silently papers over.
model WaiverSignature {
  id String @id @default(uuid())

  waiverId String
  waiver   Waiver @relation(fields: [waiverId], references: [id])

  studentId String
  student   User   @relation("WaiverSignatureStudent", fields: [studentId], references: [id])

  // Phase 37 (Guardian-on-behalf-of signing, skills/ultm8-domain-rules/SKILL.md
  // §14 — "Guardian... full access to... waiver-signing authority... for each
  // linked minor", [CONFIRMED]): the actual human who signed, which is NOT
  // always studentId — a Guardian may sign on a linked minor's behalf
  // (WaiversService.sign()'s own header comment). Always set, including for the
  // ordinary self-signing case (signedById == studentId there) — no nullable
  // "assume self if absent" convention, so every row states its real signer
  // explicitly. Backfilled from studentId for every row that predates this
  // column (this migration), since every signature before Phase 37 was
  // necessarily self-signed (no Guardian-signing path existed yet).
  signedById String
  signedBy   User   @relation("WaiverSignatureSignedBy", fields: [signedById], references: [id])

  // Denormalized from waiver.schoolId — same reasoning Membership.schoolId is
  // denormalized from membershipPlan.schoolId (Phase 9): keeps this row's own RLS
  // policy a direct column comparison rather than a join through Waiver.
  schoolId String

  signerFullName    String
  signatureText     String // see header comment — typed name, not a drawn-signature blob
  signatureImageKey String? // see header comment — R2 object key, nullable, PNG raster
  signedDate        DateTime              @default(now())
  status            WaiverSignatureStatus @default(SIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "Don't silently double-sign" — a Student may not hold two non-Expired
  // signatures for the same Waiver. Not itself a literal Spec 55 quote; flagged as
  // a Developer-level inferred constraint (Phase 10 kickoff prompt §2.2), same
  // class as this codebase's other inferred-but-reasonable defaults. Modeled as a
  // partial unique index in the migration (status != 'EXPIRED'), not a plain
  // @@unique — an Expired signature must not block re-signing.

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([studentId])
  @@index([waiverId])
  @@index([signedById])
}

// =============================================================================
// Phase 11 — ClassesModule: booking + waitlist (Spec 55 §9/§10, skills/
// ultm8-domain-rules/SKILL.md §9/§10). See the Phase 11 kickoff prompt for the full
// scoping rationale, citation-by-citation reasoning, and every Developer-level
// inference flagged explicitly there rather than silently here.
// =============================================================================

/// Booking.status — SKILL.md §10 (quoted): "Upcoming / Completed / Cancelled /
/// No-Show — four values; No-Show added to close a state-machine gap." No-Show is
/// set by the booking-no-show-processing background job only (§1.e of the kickoff
/// prompt) — never chosen directly by a caller.
enum BookingStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Booking.checkInMethod (Phase 51, Decision 107 — a flagged engineering design,
/// not a SKILL.md-confirmed enum) — which of the three check-in paths a COMPLETED
/// Booking actually went through. SELF_SERVICE is the Student's own rotating
/// Class-QR scan (Phase 13, now token-verified — see AttendanceService); the other
/// two are the Instructor roll-call scan this phase adds (SKILL.md §12, Decision
/// 71): INSTRUCTOR_SCAN when the Instructor scanned the Student's own personal
/// rotating token, INSTRUCTOR_MANUAL when Staff confirmed presence by name with no
/// token at all (Decision 107's own camera-free fallback for a Student whose
/// camera-tier consent is withdrawn, or an accessibility need). Null until a
/// Booking is actually checked in (Upcoming/Cancelled/No-Show all leave it null).
enum CheckInMethod {
  SELF_SERVICE
  INSTRUCTOR_SCAN
  INSTRUCTOR_MANUAL
}

/// Booking.refundResolution / BookingAttendee.refundResolution — a Developer-level
/// addition, not a named enum anywhere in SKILL.md's text (§10 names the FIELD
/// pair "refundResolution/resolvedBy" as confirmed, but not its value set). Null
/// until the row is actually cancelled (nothing to resolve for an Upcoming/
/// Completed booking); a No-Show never sets this either (§10: "a No-Show does not"
/// refund/restore the spent credit) — REFUNDED/WITHHELD are exclusively the two
/// outcomes of a Cancellation, chosen by comparing the cancellation time against
/// the Class's refundFeeDate cutoff (kickoff prompt §1.c).
enum RefundResolution {
  REFUNDED
  WITHHELD
}

/// WaitlistEntry.status — SKILL.md §10 (quoted): "Waiting / Notified / Claimed /
/// Expired / Cancelled."
enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
  CANCELLED
}

/// Booking (Phase 11, Spec 55 §6.1, SKILL.md §10) — belongs to a Student and a
/// Class. Confirmed fields (quoted): "class date/time, status..., sourceMembershipId
/// (which Membership's credit this Booking drew against)..., attendee list
/// (whoJoinYou)..., an overriddenBy/overrideReason pair..., and a
/// refundResolution/resolvedBy pair."
///
/// "class date/time" is NOT duplicated onto this row — derived via the `classId`
/// relation to Class.startDate/endDate instead. Flagged explicitly in the kickoff
/// prompt (§1.a) as a Developer-level inference, not a §10-confirmed choice: §10's
/// field list names it as its own field, which could equally mean a stored
/// snapshot, but nothing addresses what should happen if the Class is later
/// rescheduled (a stale snapshot vs. a derived value silently changing under an
/// existing Booking) — deriving is the simpler reading given that gap, not the
/// only defensible one.
///
/// `sourceMembershipId` funds ONLY the Student's own seat — a guest's own credit
/// source lives on their own BookingAttendee row (§10: "each attendee-list entry
/// carries its own membershipId... since a single Booking can draw against several
/// different Memberships at once").
///
/// `refundResolution`/`resolvedById` are the Student's-own-seat resolution only
/// (see RefundResolution's own comment for the exact semantics/timing) — each
/// guest's own resolution lives on their own BookingAttendee row, for the same
/// reason `sourceMembershipId` doesn't cover guests either.
///
/// RLS shape: narrow "School Owner/Manager, or the row's own Student, nobody
/// else" for ALL commands (same class of personal-record data as Membership/
/// Transaction/WaiverSignature/StudentRank — Decision 89, see the migration's own
/// policy comment) PLUS a second, additive, SELECT-only policy admitting any
/// active RoleGrant holder at the School (kickoff prompt §4 point 2) — a Class
/// roster/capacity read genuinely needs to see every Student's Booking for one
/// Class, which the narrow self-policy alone cannot serve; this follows the same
/// School/Branch three-way structure Class's own policy already established
/// (School-level grant sees every Branch; Branch-scoped grant sees its own Branch
/// plus School-wide rows), not a flat School-only check.
model Booking {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("BookingStudent", fields: [studentId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  // Denormalized from class.schoolId/branchId — same "composite index leading with
  // the tenant column" reasoning (Decision 30) as every other RLS-scoped child
  // table in this schema, avoiding a join through Class for RLS.
  schoolId String
  branchId String?

  status BookingStatus @default(UPCOMING)

  sourceMembershipId String
  sourceMembership   Membership @relation("BookingSourceMembership", fields: [sourceMembershipId], references: [id])

  // Rank-gate override (§9) — Instructor/Staff-only, always recorded together.
  overriddenById String?
  overriddenBy   User?   @relation("BookingOverriddenBy", fields: [overriddenById], references: [id])
  overrideReason String?

  // Check-in method (Phase 51, Decision 107) — same "always recorded together"
  // pairing as overriddenById/overrideReason above. checkedInById is the
  // Instructor for INSTRUCTOR_SCAN/INSTRUCTOR_MANUAL, always null for
  // SELF_SERVICE (the Student's own action, already identified by studentId —
  // recording it again here would be redundant). No separate checkedInAt column:
  // updatedAt already captures it, same as every other status transition on this
  // model (cancel, no-show) already relies on updatedAt rather than a dedicated
  // timestamp per transition.
  checkInMethod CheckInMethod?
  checkedInById String?
  checkedInBy   User?          @relation("BookingCheckedInBy", fields: [checkedInById], references: [id])

  // See RefundResolution's own comment for exactly when/how this is set.
  refundResolution RefundResolution?
  resolvedById     String?
  resolvedBy       User?             @relation("BookingResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees        BookingAttendee[]
  claimedFromEntry WaitlistEntry?    @relation("WaitlistEntryClaimedBooking")

  // Composite indexes leading with the tenant column (Decision 30). The "one
  // active Booking per Student per Class" guard (status = 'UPCOMING') is a
  // partial unique index in the migration, same technique as Membership's
  // one-active-general-access-per-school guard (Phase 9) — a Cancelled/
  // Completed/No-Show Booking must never block a fresh re-booking.
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([studentId])
  @@index([classId])
}

/// BookingAttendee (Phase 11, SKILL.md §10) — the `whoJoinYou` attendee list,
/// modeled as its own explicit relation (this schema's established convention over
/// an implicit many-to-many or a plain array/JSON column, same reasoning
/// RankRequiredSkill/StudentRankSkillStatus already used) rather than a literal
/// schema-confirmed entity name — flagged for Architect confirmation on the name
/// only, not on the underlying structure (kickoff prompt §1.a). Represents ONE
/// guest beyond the Student themselves; the Student's own seat lives directly on
/// Booking, never duplicated here.
///
/// No own `studentId` column — the guest IS a User, reachable via
/// `membership.studentId` (a guest's Friend Pass/own Membership always belongs to
/// a real User row; there is no "unregistered guest" concept anywhere in the
/// confirmed data model). Kept denormalization to just `schoolId`; RLS narrows via
/// an EXISTS subquery against this row's own Booking (see the migration) — the
/// same "delegate through the parent's own policy" pattern RankRequiredSkill
/// already established for its own join-table RLS.
model BookingAttendee {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Denormalized from booking.schoolId — RLS itself narrows via an EXISTS against
  // Booking (see migration), but every other RLS-scoped child table in this schema
  // still carries its own direct schoolId for index/query convenience (Decision 30).
  schoolId String

  membershipId String
  membership   Membership @relation("BookingAttendeeMembership", fields: [membershipId], references: [id])

  refundResolution RefundResolution?
  resolvedById     String?
  resolvedBy       User?             @relation("BookingAttendeeResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([bookingId])
  @@index([membershipId])
}

/// WaitlistEntry (Phase 11, SKILL.md §10) — belongs to a Student and a Class.
/// Confirmed fields (quoted): "FCFS position, status..., joinedAt, notifiedAt,
/// claimByDeadline (based on the School's waitlistClaimWindow setting, default 120
/// minutes, capped by the Class's own start time)." Costs no credit while Waiting;
/// only becomes a real Booking — and only then draws a credit — once Claimed
/// (`claimedBookingId` records that resulting Booking once it exists).
///
/// Claim-time rank/capacity re-validation: the kickoff prompt (§1.d) flags this as
/// its own inference, not §9/§10-confirmed — resolved to RE-CHECK at claim time
/// (state may have changed since joining), enforced in WaitlistService, not here.
///
/// RLS shape: same asymmetric narrow-self-plus-broad-Staff-read structure as
/// Booking above — see that model's own comment and the migration's policy
/// comment for the full reasoning (Decision 89 covers this table too).
model WaitlistEntry {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("WaitlistEntryStudent", fields: [studentId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  // Denormalized from class.schoolId/branchId — same reasoning as Booking above.
  schoolId String
  branchId String?

  position Int

  status WaitlistStatus @default(WAITING)

  joinedAt        DateTime  @default(now())
  notifiedAt      DateTime?
  claimByDeadline DateTime?

  claimedBookingId String?  @unique
  claimedBooking   Booking? @relation("WaitlistEntryClaimedBooking", fields: [claimedBookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes leading with the tenant column (Decision 30). "One active
  // (Waiting/Notified) WaitlistEntry per Student per Class" is a partial unique
  // index in the migration — a Claimed/Expired/Cancelled entry must never block
  // rejoining the same Class's waitlist, same reasoning as Booking's own partial
  // unique index above. `(classId, position)` supports the FCFS ordering scans
  // the claim-cascade job runs.
  @@index([schoolId])
  @@index([classId, position])
  @@index([studentId])
}

// =============================================================================
// Phase 12 — GuardianModule (Guardian linking + two-tier ConsentRecord, Spec 55
// §14). See the Phase 12 kickoff prompt for the full scoping rationale — Guardian
// acting on behalf of a minor for payments/waivers/bookings, age-13 limited login,
// and a consent-management UI are all deliberately out of scope this phase.
// =============================================================================

/// GuardianLink (Phase 12, SKILL.md §14/§17) — "Guardian 1—* linked Student
/// (minor) profiles." A Developer-level model name (no schema-confirmed name
/// given, same class of naming latitude as BookingAttendee/RankRequiredSkill).
/// Whether the REVERSE (multiple Guardians linked to the same minor) is intended
/// isn't confirmed either way — resolved to ALLOW it (no uniqueness constraint
/// blocking a second Guardian from linking the same minor), the lower-risk
/// default given real-world co-parenting is a real, plausible case nothing here
/// confirms is disallowed. Flagged, not asserted as settled (see the Phase 12
/// kickoff prompt §1 and Decision 92).
model GuardianLink {
  id String @id @default(uuid())

  guardianId String
  guardian   User   @relation("GuardianLinkGuardian", fields: [guardianId], references: [id])

  studentId String
  student   User   @relation("GuardianLinkStudent", fields: [studentId], references: [id])

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([guardianId, studentId])
  @@index([studentId])
}

/// ConsentRecord.tier — SKILL.md §14 (quoted): "carries two tiers, not one: a
/// baseline tier covering the general account/attendance/grading data every
/// Guardian-linked minor account requires, and a separate camera tier tied
/// specifically to QR-check-in camera use and profile-photo capture."
enum ConsentTier {
  BASELINE
  CAMERA
}

/// ConsentRecord.status — SKILL.md §14 (quoted): "status (Active / Withdrawn,
/// with its own withdrawal timestamp)."
enum ConsentStatus {
  ACTIVE
  WITHDRAWN
}

/// ConsentRecord (Phase 12, SKILL.md §14) — "a new, first-class, auditable,
/// revocable consent entity — distinct from WaiverSignature." Confirmed fields
/// (quoted): "Guardian reference, linked-minor (Student) reference, policyVersion
/// (the specific privacy-notice/data-practice description consented to...),
/// timestamp, and status."
///
/// PLATFORM-scoped, not School-scoped — §14 itself: "deliberately not COPPA-
/// specific... built to the general shape shared by GDPR Art. 8, UK-GDPR, and
/// LGPD" (the literal phrase "platform-scoped" is §16's own canonical-
/// terminology gloss, cited together, not spliced as one continuous §14 quote).
/// This is NOT the first schoolId-less table in this schema — User itself has
/// none, and already has an established RLS shape for that
/// (user_self_or_shared_school, joining through RoleGrant) — but it IS the first
/// with no shared-visibility branch at all: self-only, full stop. See Decision
/// 92 for the full RLS reasoning, including why a `ultm8_jobs` read policy is
/// still needed here despite the narrow self-only shape (Attendance, Phase 13,
/// needs to check a specific Student's own camera-tier status from an
/// interactive scan request, not from the Guardian who owns the row).
///
/// One row per (guardian, student, tier) — a tier is its own independently
/// revocable consent, not a boolean flag on a shared row. Multi-Guardian
/// interaction (what happens if one Guardian withdraws baseline while another's
/// own baseline consent for the same Student is still Active) isn't addressed
/// anywhere in the confirmed text — resolved to the most literal reading:
/// withdrawing ANY Guardian's own baseline consent for a Student triggers the
/// full cascade for that Student regardless of any other Guardian's consent
/// state, rather than inventing an "unless someone else still consents"
/// exception nothing confirms. Flagged, not asserted as the only defensible
/// reading (Decision 92).
model ConsentRecord {
  id String @id @default(uuid())

  guardianId String
  guardian   User   @relation("ConsentRecordGuardian", fields: [guardianId], references: [id])

  studentId String
  student   User   @relation("ConsentRecordStudent", fields: [studentId], references: [id])

  tier          ConsentTier
  policyVersion String

  status ConsentStatus @default(ACTIVE)

  consentedAt DateTime  @default(now())
  withdrawnAt DateTime?

  @@unique([guardianId, studentId, tier])
  @@index([studentId, tier])
}

/// Notification (Phase 15, Spec 55 §6.1, page 27) — confirmed field list (quoted,
/// not paraphrased): "Title/body, read state, target user." Relationship:
/// "Belongs to User." That is the entire confirmed entry — three fields, no
/// channel/type/category field, no delivery-status field. `type` below is a
/// Developer-level addition (a discriminator string other modules can filter/
/// render by — e.g. "WAIVER_SIGNATURE_REQUEST"), flagged for Architect review,
/// same treatment as every other reasonable-minimum addition in this codebase
/// (User.phoneVerifiedAt is the established precedent this follows). Deliberately
/// a free String, not an enum — Spec 55 §9's own trigger list for the
/// notification-fanout job is explicitly open-ended ("Any of the above, plus
/// manual school messages"), and a Postgres enum requiring a migration for every
/// new trigger type is a worse fit for that than a free string.
///
/// Self-only RLS (userId = caller), same shape ConsentRecord established —
/// nothing in the confirmed text suggests any shared-visibility branch (a School
/// Owner has no stated reason to read another User's private notification feed).
/// A `ultm8_jobs` INSERT+SELECT policy is additive on top — the
/// notification-fanout job (this phase) is what actually writes rows for a
/// target OTHER than the calling context (e.g. every Student at a School, when a
/// Waiver is assigned) — the same cross-user-write gap Booking's capacity check
/// and the Guardian consent-withdrawal cascade each already hit, closed the same
/// established way. SELECT (not just INSERT) is needed for the same reason
/// class_jobs_select_for_returning exists: Prisma's `.create()` always does
/// `INSERT ... RETURNING *`.
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String
  body  String
  read  Boolean @default(false)

  /// Developer-level addition — see the model's own header comment.
  type String?

  createdAt DateTime @default(now())

  // Composite index matching NotificationsService.findAllForCaller's actual
  // query shape (WHERE userId = ? AND (createdAt, id) < cursor ORDER BY
  // createdAt DESC, id DESC) — found on review to be a genuine mismatch in an
  // earlier draft, which indexed (userId, read) and (userId, createdAt)
  // separately while the query itself paginates by (userId, createdAt, id)
  // together; neither prior index actually served it, and one served nothing
  // in this phase's own code at all (no query filters by `read` alone).
  @@index([userId, createdAt, id])
}

/// DeviceToken (Phase 15, Spec 55 §6.1, Decision 46, page 28) — confirmed field
/// list (quoted): "userId, platform, token, app variant reference (shared
/// Student app or a specific School's TenantAppConfig), last-seen timestamp."
/// Relationship: "Belongs to User; referenced by push-notification delivery to
/// route a push to the correct credential set."
///
/// The "app variant reference" field is deliberately NOT built this phase —
/// `TenantAppConfig` (white-label branding config) doesn't exist yet
/// (MobileAppPublishingModule is blocked behind SubscriptionPlansModule, itself
/// blocked behind PlatformAdminModule's SSO decision — see the project roadmap).
/// Every registered token this phase is implicitly "the shared ULTM8 app" —
/// there is no other app variant to distinguish yet. Add the field (and its
/// FK) when MobileAppPublishingModule ships, not preemptively.
///
/// Actual push SEND (FCM/APNs dispatch) is also deliberately NOT built this
/// phase — see NotificationsModule's own header comment for the full scoping
/// reasoning (email delivery via Postmark/SES is the one real, working channel
/// this phase; push gets its data model built and ready, not its dispatch).
/// `platform` is scoped to the two confirmed vendors (§11.4: "FCM (Android)/APNs
/// (iOS)") — no WEB value, since browser push was never itself confirmed
/// anywhere in Spec 55.
///
/// Self-only RLS, ALL commands, TO ultm8_app — registration always happens
/// under the owning caller's own context (unlike Notification, nothing else
/// ever needs to write a DeviceToken row on another User's behalf), so no
/// `ultm8_jobs` bypass is needed yet. Add SELECT for `ultm8_jobs` only once a
/// future phase actually implements push dispatch and needs to look up a
/// target's tokens — not preemptively (PrismaJobsService's own header comment:
/// "add the specific grant a new job actually needs... don't broaden a call
/// site here into a general-purpose cross-tenant read").
///
/// FOUND ON REVIEW — a real judgment call, not an oversight: is registering
/// DeviceToken rows with zero server-side consumer (push dispatch) the same
/// "speculative infrastructure ahead of a real caller" mistake
/// StripeClientService's own header comment describes removing from an
/// earlier Phase 8 draft? Decided NOT the same case, for reasons that
/// draft didn't have: (1) this entity has real, passing e2e coverage
/// (register/re-register/deregister/isolation), unlike that draft, which was
/// "unused and untested"; (2) the field shape is narrow and comes directly
/// from a confirmed entity (Decision 46), not invented; (3) unlike a payments
/// client a backend module calls internally, DeviceToken registration is
/// something a MOBILE CLIENT needs to call as soon as it builds notification-
/// permission UI — which realistically happens well before server-side push
/// dispatch is wired, so building the registration endpoint now avoids a
/// client/server sequencing problem later. Recorded in Decision 95, not
/// silently asserted.
model DeviceToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  platform DevicePlatform
  token    String         @unique

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
}
