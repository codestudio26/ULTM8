// ULTM8 Prisma schema — Phase 1 walking skeleton.
//
// Scope: exactly the 6 core entities named in Phase 1's task — User, RoleGrant,
// AdminUser, Franchise, School, Branch. Everything else (Class, Booking, Membership,
// Waiver, StudentRank, ...) is out of scope for this pass and intentionally absent.
//
// Sources (cite-back, per ultm8-domain-rules §20 rule 5):
//   - Field lists: ultm8-domain-rules §2/§3/§6.1, Spec 55 §6.1 (Franchise/School entity rows)
//   - Branch field set: Decision 76, docs/decisions/POST-SPEC-55-DECISION-LOG.md
//   - RoleGrant shape (user_id, role, scope, granted_by, granted_at, revoked_at): domain-rules §3
//   - AdminUser as a wholly separate identity, never joined to User: ultm8-tenant-isolation §3
//   - RLS keying (franchise_id/school_id, +branch_id for the 4 Branch-scoped entities —
//     none of which exist yet in this schema pass): ultm8-tenant-isolation §2
//   - Composite indexes leading with the tenant column: Decision 30
//
// RLS policies are NOT expressible in schema.prisma (Prisma has no first-class RLS
// feature) — they live in prisma/migrations/20260902000000_init/migration.sql, hand-
// authored and clearly marked as a Developer-level design applying the confirmed
// tenant-isolation principles above. Flagged for Architect review, same as the AuthModule
// lockout/recovery minimum below — see the Phase 1 summary for the full list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The 6 confirmed customer-facing roles a RoleGrant can carry (Spec 55 §8.2).
/// Platform Admin is deliberately excluded — that's the separate AdminUser realm below,
/// never a RoleGrant value (ultm8-tenant-isolation §3).
enum Role {
  STUDENT
  SCHOOL_OWNER_MANAGER
  BRANCH_STAFF
  INSTRUCTOR
  FRANCHISE_OWNER
  GUARDIAN
}

/// Platform Admin's three least-privilege sub-roles (ultm8-tenant-isolation §3).
enum AdminSubRole {
  SUPPORT
  BILLING_PAYMENTS_OPS
  FULL_ADMIN
}

/// Franchise.feeModel — Flat or Per-Headcount (domain-rules §2, confirmed).
enum FeeModel {
  FLAT
  PER_HEADCOUNT
}

/// School.classCancellationPolicy — Manual (default) / Auto-Refund / Auto-Credit
/// (domain-rules §7, confirmed). Not exercised by any Phase 1 endpoint yet — Bookings/
/// Classes are out of scope — but it's a confirmed School-entity column, so it's modeled
/// now rather than half-modeling School.
enum ClassCancellationPolicy {
  MANUAL
  AUTO_REFUND
  AUTO_CREDIT
}

/// School.franchiseFeeSubscriptionStatus — synced from the Franchise-fee Stripe
/// Subscription (domain-rules §2, Spec §6.1). Nullable on the model since it only
/// applies to a School actually under a Franchise.
enum FranchiseFeeSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// TimetableSlot.weekday — Phase 5. Confirmed field ("Week day"), Spec 55 §6.1.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// TimetableSlot.status — Phase 5. Confirmed field ("status (On/Off)"), Spec 55 §6.1 —
/// modeled as this exact On/Off language, not a generic isActive boolean, so the schema
/// reads the same as the spec.
enum TimetableSlotStatus {
  ON
  OFF
}

/// PaymentAccount.provider — Phase 8. Confirmed field ("Provider (Stripe/Cash/Bank
/// Transfer per Section 1.2 decision)"), Spec 55 §6.1.
enum PaymentAccountProvider {
  STRIPE
  CASH
  BANK_TRANSFER
}

/// PaymentAccount.status — Phase 8. Confirmed field ("status (Active/De-active)"),
/// Spec 55 §6.1 — kept as this exact spelling, not normalized to a generic INACTIVE,
/// same "read the same as the spec" convention TimetableSlotStatus above already set.
enum PaymentAccountStatus {
  ACTIVE
  DE_ACTIVE
}

/// PaymentAccount.mode — Phase 8. Confirmed field ("mode (Live/Test)"), Spec 55 §6.1.
enum PaymentAccountMode {
  LIVE
  TEST
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

/// Base customer-facing identity shared by every tenant-side role (Student, School
/// Owner/Manager, Branch Staff, Instructor, Franchise Owner, Guardian). Role/scope is
/// NEVER a column here — RoleGrant is the sole source of truth (domain-rules §3).
model User {
  id    String @id @default(uuid())
  email String @unique
  phone String @unique // E.164, validated at the DTO layer

  firstName String
  surname   String
  username  String? @unique // mobile-only per confirmed field list; nullable elsewhere

  /// bcrypt hash of the 6-digit passcode — the account's sole login credential
  /// (Decision 72). Never store the raw passcode.
  passcodeHash String

  /// Set once Twilio Verify OTP confirms this phone (Spec §8.1's registerScreen ->
  /// verificationPin flow). NOT a confirmed schema field — a Developer-added column
  /// needed to make that two-step, spec-described flow actually functional; flagged
  /// for Architect review. Login is blocked while this is null (see AuthService) —
  /// that gate is a reasonable-minimum choice, not a confirmed business rule; flag if
  /// wrong.
  phoneVerifiedAt DateTime?

  dateOfBirth     DateTime @db.Date // ISO 8601 date, no time component (confirmed)
  gender          String?
  nationality     String?
  language        String? // one of the 4 confirmed languages; stored as free text pending
  // a confirmed canonical code list (not specified anywhere)
  currency        String? // one of the 6 confirmed currencies; same caveat as above
  address         String?
  profilePhotoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleGrants           RoleGrant[]     @relation("RoleGrantUser")
  grantsIssued         RoleGrant[]     @relation("RoleGrantGrantedBy")
  classesTaught        Class[]         @relation("ClassInstructor")
  timetableSlotsTaught TimetableSlot[] @relation("TimetableSlotInstructor")
  instructorProfiles   Instructor[]

  @@index([email])
  @@index([phone])
}

/// Platform Admin identity — wholly separate from User, never joined to it
/// (ultm8-tenant-isolation §3). Authenticates via SSO against the company's own IdP
/// (Spec §4.4); ssoSubject is the federated-identity linkage, not a local password.
model AdminUser {
  id      String       @id @default(uuid())
  email   String       @unique
  name    String
  subRole AdminSubRole

  /// Subject identifier from the external SSO IdP (§4.4) — no local credential is
  /// stored here; ULTM8 never owns Platform Admin's authentication factor directly.
  ssoSubject String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime? // access revoked immediately on offboarding (§4.4)
}

/// The sole source of truth for who holds what role, where (domain-rules §3, §6.1).
/// franchiseId / schoolId / branchId together encode "scope": a Franchise Owner grant
/// sets only franchiseId; a School-scoped grant (Owner/Manager, Instructor) sets
/// schoolId with branchId null (== "sees all Branches under this School", §4.3); a
/// Branch Staff grant sets both schoolId and branchId.
model RoleGrant {
  id   String @id @default(uuid())
  role Role

  userId String
  user   User   @relation("RoleGrantUser", fields: [userId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  grantedById String?
  grantedBy   User?   @relation("RoleGrantGrantedBy", fields: [grantedById], references: [id])

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId, revokedAt])
  @@index([franchiseId, revokedAt])
  @@index([branchId, revokedAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tenancy: Franchise -> School -> Branch
// ---------------------------------------------------------------------------

/// Franchise (domain-rules §2, Spec §6.1). A School's link to a Franchise is optional —
/// modeled as a nullable FK on School, not required here.
model Franchise {
  id   String @id @default(uuid())
  name String

  mobileNumber    String?
  address         String?
  type            String?
  activities      String[] @default([])
  facilities      String[] @default([])
  defaultLanguage String?
  defaultCurrency String?
  description     String?
  logoUrl         String?
  bannerUrl       String?

  feeModel FeeModel @default(FLAT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools        School[]
  roleGrants     RoleGrant[]
  paymentAccount PaymentAccount?

  @@index([name])
}

/// School (domain-rules §2, Spec §6.1). franchiseId is nullable — an independent,
/// non-franchised School is a first-class case, not an edge case (confirmed).
model School {
  id String @id @default(uuid())

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  name         String
  mobileNumber String?
  address      String?
  businessType String?
  activities   String[] @default([])
  facilities   String[] @default([])
  ranksToggle  Boolean  @default(false)

  defaultLanguage String?
  defaultCurrency String?
  description     String?
  logoUrl         String?
  bannerUrl       String?

  classCancellationPolicy        ClassCancellationPolicy         @default(MANUAL)
  waitlistClaimWindowMinutes     Int                             @default(120)
  franchiseFeeSubscriptionStatus FranchiseFeeSubscriptionStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  roleGrants     RoleGrant[]
  classes        Class[]
  timetableSlots TimetableSlot[]
  instructors    Instructor[]
  paymentAccount PaymentAccount?

  // Composite index leading with the tenant column (Decision 30) — School's own
  // "tenant column" one level up is franchiseId.
  @@index([franchiseId])
}

/// Branch (Decision 76 — field set mirrors School's profile fields; the RLS-enforced
/// access-boundary role for TimetableSlot/Class/Instructor/Booking is asserted in
/// ultm8-tenant-isolation §2 — Class is the first of those 4 to actually exist in this
/// schema, added in Phase 4; TimetableSlot/Instructor(-as-its-own-table)/Booking still
/// don't).
model Branch {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name             String
  address          String?
  contactPhone     String?
  timezone         String? // IANA tz name, per the glossary convention (Spec §14)
  currencyOverride String?
  logoUrl          String?
  bannerUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleGrants     RoleGrant[]
  classes        Class[]
  timetableSlots TimetableSlot[]
  instructors    Instructor[]

  // Composite index leading with the tenant column (Decision 30).
  @@index([schoolId])
}

/// Class (domain-rules §9, Spec §6.1) — Phase 4. A bookable Class row is either
/// materialized from a recurring TimetableSlot (TimetableModule, deferred to Phase 5
/// alongside the BullMQ/Redis infrastructure the materialization job needs) or, as
/// built here, created directly as an independent, one-off event. Booking/waitlist are
/// explicitly out of scope this phase (see the Phase 4 kickoff prompt) — Booking
/// creation requires an Active Membership check (§10) and MembershipsModule/Stripe
/// integration don't exist yet, so no Booking relation is modeled here either.
///
/// instructorId points at User directly, NOT a separate Instructor table — domain-rules
/// §6.1 confirms RoleGrant (not a dedicated table) is the sole source of truth for who
/// holds the Instructor role; "taught by an Instructor" means "instructorId references a
/// User holding an active INSTRUCTOR RoleGrant at this Class's School", validated in
/// ClassesService, not enforced by a DB constraint.
///
/// branchId is nullable — not itself part of §9's confirmed field list, but Branch's own
/// role as "the RLS-enforced access boundary for ... Class" (Decision 76) requires SOME
/// branch relationship; nullable mirrors RoleGrant.branchId's already-established
/// "School-wide by default, narrowable to one Branch" shape. Inferred, not confirmed —
/// flagged for Architect review.
model Class {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  instructorId String?
  instructor   User?   @relation("ClassInstructor", fields: [instructorId], references: [id])

  /// Phase 5 — set only on a Class materialized by the class-occurrence-generation job
  /// from a recurring TimetableSlot (nullable timetableSlotId, Spec 55 §6.1); null for
  /// an independent one-off Class. occurrenceDate is the date-only companion this pairs
  /// with — together they back the @@unique below, which is what makes the job's
  /// "unless one already exists for that slot+date" behavior an actual DB-level
  /// guarantee rather than an application-level check-then-insert race.
  timetableSlotId String?
  timetableSlot   TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  occurrenceDate  DateTime?      @db.Date

  title       String
  // Cardinality (required, at least one) is an inferred design choice, not stated by
  // §9 — flagged for Architect review same as branchId above.
  activities  String[] @default([])
  bannerUrl   String?
  description String?

  startDate DateTime
  endDate   DateTime

  capacity Int? // nullable = unlimited (confirmed)

  bookingEndAt      DateTime?
  qrAttendanceEndAt DateTime?
  refundFeeDate     DateTime?

  // Minor-unit integer (cents), not Decimal/float — no existing precedent in this schema
  // for a money field; minor-unit integers are consistent with domain-rules §7's existing
  // "rounded once to the currency's minor unit" rule and avoid float-rounding entirely.
  // Flagged for Architect review, same as the other inferred choices on this model.
  cancellationCharge Int?

  termsWaiverRequired Boolean @default(false)
  membershipInclusion Boolean @default(false) // default is opt-out (confirmed §6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The DB-level guarantee behind "the job never double-materializes the same
  // occurrence" — see the comment on timetableSlotId/occurrenceDate above. Postgres
  // treats NULL as distinct from NULL in a unique constraint, so this imposes no
  // restriction on one-off Classes (timetableSlotId/occurrenceDate both null).
  @@unique([timetableSlotId, occurrenceDate])
  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([timetableSlotId])
}

/// TimetableSlot (Phase 5, Spec 55 §6.1/§9) — a School's recurring weekly schedule.
/// Confirmed field list (quoted, not paraphrased): "Week day, start time, end time,
/// start break, end break, status (On/Off)." Relations: "Belongs to School (and
/// Instructor, inferred); recurring weekly pattern, not date-specific; has many
/// generated Class occurrences."
///
/// branchId is directly confirmed (not inferred the way Class's was) — Spec 55 §4.3
/// explicitly names TimetableSlot as one of the 4 entities keyed on branch_id for RLS.
/// Nullable for the same reason Class's is: School-wide by default, narrowable to one
/// Branch.
///
/// instructorId gets the same "active INSTRUCTOR RoleGrant holder, not a separate
/// table" treatment as Class's — but Spec 55 itself marks this relation "inferred",
/// not confirmed the way the field list is. Same caution Class's instructorId got in
/// Phase 4, carried forward rather than treated as more settled here.
///
/// Everything below `status` is a Developer-level addition beyond Spec 55's confirmed
/// six fields, resolved directly with the product owner during Phase 5 scoping (record
/// as a Decision, same pattern as Decisions 82-84): the confirmed six give the
/// class-occurrence-generation job nothing it needs to actually build a Class (no
/// title, no activities, no capacity — both of the latter two are required on Class).
/// These are template fields, copied onto every generated Class:
///   - title, activities, capacity, description, bannerUrl, termsWaiverRequired,
///     membershipInclusion — same field names/types/validation constraints as Class's
///     own; CreateTimetableSlotDto's validation MUST mirror CreateClassDto's exactly
///     for each of these, or a TimetableSlot that passes its own looser validation can
///     still fail deep inside the background job when the Class gets created.
///   - bookingCutoffMinutesBeforeStart / qrAttendanceWindowMinutes /
///     refundCutoffHoursBeforeStart — NOT copies of Class's bookingEndAt/
///     qrAttendanceEndAt/refundFeeDate, which are absolute datetimes that don't mean
///     anything on a recurring template. These are durations instead; the job resolves
///     each into a real datetime relative to that specific occurrence's startDate.
///   - cancellationCharge copies straight across unchanged (already a plain amount).
model TimetableSlot {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  instructorId String?
  instructor   User?   @relation("TimetableSlotInstructor", fields: [instructorId], references: [id])

  weekday Weekday

  startTime  DateTime  @db.Time(0)
  endTime    DateTime  @db.Time(0)
  breakStart DateTime? @db.Time(0)
  breakEnd   DateTime? @db.Time(0)

  status TimetableSlotStatus @default(ON)

  // Template fields — copied verbatim onto every generated Class. See the model
  // header comment above for why these exist beyond Spec 55's confirmed six.
  title       String
  activities  String[] @default([])
  capacity    Int?
  description String?
  bannerUrl   String?

  termsWaiverRequired Boolean @default(false)
  membershipInclusion Boolean @default(false)

  // Durations, not absolute dates — resolved per-occurrence by the job. See the model
  // header comment above.
  bookingCutoffMinutesBeforeStart Int?
  qrAttendanceWindowMinutes       Int?
  refundCutoffHoursBeforeStart    Int?
  cancellationCharge              Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedClasses Class[]

  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
}

/// Instructor (Phase 6, Spec 55 §6.1) — a profile/bio *extension* for a person who
/// already holds the INSTRUCTOR role, NOT the source of truth for whether they hold it
/// (that stays RoleGrant, checked via TenantAuthorizationService.assertValidInstructor
/// — see the Phase 6 kickoff prompt). Confirmed field list (quoted, not paraphrased):
/// "Name, photo, belt/ranking, specializations (activities), phone, years of
/// experience, bio; linked User account for its own login."
///
/// This does NOT reverse the Phase 4/5 decision that Class.instructorId/
/// TimetableSlot.instructorId stay FKs into User, not this table — "taught by an
/// Instructor" still means "instructorId references a User holding an active
/// INSTRUCTOR RoleGrant", per those models' own comments. Instructor here is never the
/// FK target for instructorId anywhere, and is never itself consulted to answer
/// "does this User hold the Instructor role" — two genuinely separate concerns, kept
/// separate on purpose. Flagged for Architect review since this is new surface area
/// immediately adjacent to that settled decision.
///
/// branchId is directly confirmed, not inferred — Spec 55 explicitly names Instructor
/// (alongside TimetableSlot, Class, Booking) as one of the 4 entities RLS keys on
/// branch_id. Nullable for the same "School-wide by default, narrowable to one Branch"
/// reason Class's/TimetableSlot's own branchId is.
///
/// @@unique is [schoolId, userId], deliberately NOT [schoolId, branchId, userId] — one
/// shared profile row per person per School even though their RoleGrant(s) could in
/// principle be Branch-scoped at more than one Branch of the same School. Flagged for
/// Architect review as an inferred simplification; the confirmed text doesn't settle
/// whether a multi-Branch Instructor needs distinct per-Branch profiles.
model Instructor {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  photoUrl String?

  /// Plain display text, NOT a live reference into StudentRank/Rank — RanksModule
  /// doesn't exist yet, and nothing confirms an Instructor's shown rank must be sourced
  /// from that system rather than self-reported text.
  beltRanking String?

  specializations String[] @default([])

  /// Distinct, optional School-facing contact number — Spec 55 lists `phone` on
  /// Instructor's own entity row, separate from User.phone (the login/OTP number). Not
  /// assumed identical to User.phone without confirmation.
  phone String?

  yearsOfExperience Int?
  bio               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One profile per person per School — see the model header comment above for why
  // this is deliberately not also keyed on branchId.
  @@unique([schoolId, userId])
  // Composite indexes leading with the tenant column (Decision 30).
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([userId])
}

/// LegalDocument (Phase 7, Spec 55 SettingsModule row) — storage for GET
/// /legal/{doc}. `content` is nullable and starts null for every seeded row — Spec
/// 55's own screen inventory never captured real Terms & Conditions/Privacy
/// Statement text ("Content screens, no CMS fields beyond static text observed"),
/// and that text must come from actual legal/product input, never invented here.
/// No admin-authoring endpoint exists yet (needs Platform Admin auth, §4.4 — not
/// built, see the Phase 7 kickoff prompt) — until then this table can only be
/// populated by a direct DB write/seed, not through the API.
///
/// Why a real table here and not a TS constant like SettingsModule's own
/// languages/currencies lists (constants/languages.ts, constants/currencies.ts)?
/// NOT because this is "a confirmed endpoint and they aren't" — all three are
/// equally confirmed endpoints, and this table is in exactly the same
/// no-confirmed-write-path position they are (caught on code review: an earlier
/// draft of this comment used that reasoning, and it doesn't actually hold up — a
/// migration-seeded INSERT isn't meaningfully more "dynamic" than a TS constant,
/// both need a deploy to change). The real distinguishing factor is content shape
/// and growth direction: `content` is meant to eventually hold arbitrary long-form
/// text authored through a future admin CMS flow — the same category Spec 55
/// explicitly describes TranslationsModule's own content as ("CMS-backed... not
/// static JSON") — where a language/currency list is a small, closed reference set
/// with no comparable long-form-content future. A per-row `updatedAt` and a
/// human-meaningful `slug` primary key are exactly the shape that content
/// eventually wants and a closed reference list doesn't need.
///
/// No RLS — not tenant-scoped data (global, platform-level legal content).
/// Precedent-checked, not just asserted: AdminUser (CREATE TABLE'd in
/// 20260902000000_init but never gets ENABLE ROW LEVEL SECURITY) genuinely
/// establishes that a table with no tenant column can skip RLS in this codebase —
/// but AdminUser has never actually been queried by any service code anywhere in
/// this repo (verified by grep), and its own migration comment says its access "is
/// gated entirely at the application layer via the separate Platform Admin
/// identity realm, which doesn't exist yet." So AdminUser is real precedent for
/// "this table needs no RLS policy" — it is NOT precedent for "query the bare
/// PrismaAppService client directly, bypassing withTenantContext," which
/// SettingsService does here for the first time in this codebase, reasoned
/// correctly from withTenantContext's own implementation (see its call site's own
/// comment), not by following an already-established querying pattern that turns
/// out not to exist.
model LegalDocument {
  /// URL-slug identity, not a UUID — the confirmed route is GET /legal/{doc}, a
  /// human-meaningful key ("terms-and-conditions"), not an opaque id.
  slug String @id

  title   String
  content String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// PaymentAccount (Phase 8, Spec 55 §6.1) — a School's or a Franchise's own Stripe
/// Connect Express account reference (Decision 86,
/// docs/decisions/POST-SPEC-55-DECISION-LOG.md). No raw secret keys are ever stored
/// (§4.5/§10.4) — only the Connected Account id.
///
/// Belongs to School OR Franchise, never both — mirrors the polymorphic-owner shape,
/// not RoleGrant's three-way scope triple (RoleGrant's franchiseId/schoolId/branchId
/// together encode ONE grant's scope; here schoolId/franchiseId are two alternate
/// owners for two structurally separate rows — a School's own PaymentAccount and a
/// Franchise's own PaymentAccount are different rows for different purposes,
/// confirmed: "never a School's PaymentAccount directly" for Franchise-fee income).
/// Enforced BOTH at the application layer (PaymentsService) AND, added on code
/// review, a real DB CHECK constraint (num_nonnulls(schoolId, franchiseId) = 1, in
/// the migration) — an earlier draft left this app-layer-only, reasoning no
/// precedent in this schema covered a multi-column exclusive-OR constraint; given
/// how financially load-bearing this table is, the migration's own comment explains
/// why that reasoning didn't hold up for this specific table.
///
/// The Franchise side is schema-correct but practically unreachable this phase — no
/// FranchisesController/FranchisesService exists anywhere in this codebase yet
/// (Phase 2 deliberately deferred Franchise CRUD), and FRANCHISE_OWNER is
/// deliberately excluded from GrantableRoleDto (see its own header comment) — there
/// is no self-service way for anyone to hold a FRANCHISE_OWNER grant in this product
/// today. See the Phase 8 kickoff prompt for the full reasoning.
model PaymentAccount {
  id String @id @default(uuid())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  provider     PaymentAccountProvider
  accountTitle String
  country      String
  status       PaymentAccountStatus @default(ACTIVE)
  mode         PaymentAccountMode   @default(TEST)

  /// Never a raw secret key (Decision, existing, §4.5/§10.4). Null until Stripe
  /// Connect onboarding is initiated — set synchronously in
  /// PaymentsService.initiateConnectOnboarding() from Stripe's own accounts.create()
  /// response, NOT by a webhook handler. (Corrected from an earlier draft of this
  /// comment, which assumed the id itself arrived via the account.updated webhook —
  /// checked directly against Stripe's own API shape before writing the service
  /// method: accounts.create() returns the new Connected Account's id synchronously,
  /// no webhook needed for that specific value. See that method's own comment.)
  stripeConnectedAccountId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One PaymentAccount per School, one per Franchise — "has one PaymentAccount set"
  // (School's and Franchise's own confirmed entity rows, singular).
  @@unique([schoolId])
  @@unique([franchiseId])
}

/// ProcessedStripeEvent (Phase 8) — Stripe webhook idempotency ledger. Spec 55 §10.2's
/// own confirmed idempotency mechanism: "idempotency is enforced by deduping on
/// Stripe's event id before processing, since Stripe may redeliver the same webhook
/// more than once." A Postgres row, not a BullMQ jobId-based dedup or an in-memory
/// set — checked directly, not assumed: BullMQ's own completed-job retention is
/// bounded (removeOnComplete-style pruning) and reset on every deploy, whereas Stripe
/// can redeliver a webhook well after a completed job would have been pruned; this
/// needs a durable, permanent record, the same reasoning that already put
/// class-occurrence-generation's own idempotency guarantee at the database level
/// (its @@unique on timetableSlotId/occurrenceDate) rather than in application memory.
/// This is a new pattern for webhook-specific idempotency in this codebase — flagged
/// as such, not presented as following an existing precedent that doesn't exist.
///
/// No RLS — not tenant-scoped data (a platform-level operational ledger, same
/// category as AdminUser/LegalDocument, which also carry none).
model ProcessedStripeEvent {
  /// Stripe's own event id (e.g. "evt_...") — the de-dup key itself, not a
  /// separately-generated UUID.
  stripeEventId String @id

  eventType String

  processedAt DateTime @default(now())
}
