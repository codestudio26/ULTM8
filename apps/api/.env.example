# Copy to .env and fill in for local development.
# apps/api needs a real Postgres instance to exercise Prisma/RLS — see prisma/README.md.

DATABASE_URL="postgresql://ultm8_owner:changeme@localhost:5432/ultm8?schema=public"
# Non-superuser, RLS-subject application role — required for RLS to actually be enforced
# (a superuser or table-owner connection bypasses RLS regardless of policies).
# See prisma/migrations/20260902000000_init/migration.sql for how this role is created.
DATABASE_URL_APP="postgresql://ultm8_app:changeme@localhost:5432/ultm8?schema=public"
# SELECT-only role used solely for pre-authentication credential lookup (login-by-email,
# registration's already-taken check) — see the user_auth_lookup RLS policy.
DATABASE_URL_AUTH="postgresql://ultm8_auth:changeme@localhost:5432/ultm8?schema=public"
# Phase 5 — background jobs with no single caller/tenant context (e.g.
# class-occurrence-generation, a cross-tenant sweep). SELECT on TimetableSlot/Branch,
# INSERT-only on Class — see prisma/migrations/20260908000000_timetable_module.
DATABASE_URL_JOBS="postgresql://ultm8_jobs:changeme@localhost:5432/ultm8?schema=public"
# Phase 14 — AcademiesModule's own dedicated role for cross-School discovery reads
# (browsing Schools the caller holds no RoleGrant at). Deliberately NOT ultm8_app or
# ultm8_jobs — see prisma/migrations/20260917000000_academies_discovery_module and
# Decision 94 (docs/decisions/POST-SPEC-55-DECISION-LOG.md) for why a shared role would
# have silently widened isolation for every other module reading the same tables.
# Column-level GRANTs restrict this role to exactly AcademiesService's curated fields.
DATABASE_URL_DISCOVERY="postgresql://ultm8_discovery:changeme@localhost:5432/ultm8?schema=public"

JWT_ACCESS_SECRET="replace-with-a-real-secret-min-32-chars"
JWT_ACCESS_TTL="15m"

# Twilio Verify — Spec 55 §11.4 (confirmed OTP provider). Registration-flow only per
# Decision 72's own follow-up note: routine login uses passcode alone, not OTP.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Phase 5 — first Redis/BullMQ usage in this codebase (otp-delivery,
# class-occurrence-generation). App boots without it reachable, same as every other
# unconfigured external dependency here — queue operations fail until it's set.
REDIS_URL="redis://localhost:6379"

# Phase 8 — Stripe (Spec 55 §10, §10.4; Decision 86: Connect account type is Express).
# ULTM8's own platform-level secret key — never a tenant's; PaymentsModule constructs
# a per-tenant scoped client from a Connected Account id instead (see
# StripeClientService.scopedClient()). App boots without it set, same as every other
# unconfigured external dependency here — Stripe API calls fail until it's set.
STRIPE_SECRET_KEY=""
# For stripe.webhooks.constructEvent() signature verification on
# POST /payments/webhooks/stripe — from the Stripe Dashboard's webhook-endpoint config.
STRIPE_WEBHOOK_SECRET=""
# Stripe Connect Express onboarding's own required Account Link redirect targets —
# Stripe's own API requirement, not a Spec 55-confirmed field; a Developer-level
# addition needed to make the confirmed onboarding flow actually functional, same
# treatment Phase 1 gave phoneVerifiedAt.
STRIPE_CONNECT_RETURN_URL="http://localhost:5173/payments/connect/return"
STRIPE_CONNECT_REFRESH_URL="http://localhost:5173/payments/connect/refresh"

PORT=3000

# Comma-separated list of origins allowed to call this API cross-origin (browser
# clients, e.g. apps/school-portal). Defaults to http://localhost:5173 if unset —
# see main.ts's own comment for why this fails safe rather than falling back to a
# permissive default.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
