# Copy to .env and fill in for local development.
# apps/api needs a real Postgres instance to exercise Prisma/RLS — see prisma/README.md.

DATABASE_URL="postgresql://ultm8_owner:changeme@localhost:5432/ultm8?schema=public"
# Non-superuser, RLS-subject application role — required for RLS to actually be enforced
# (a superuser or table-owner connection bypasses RLS regardless of policies).
# See prisma/migrations/20260902000000_init/migration.sql for how this role is created.
DATABASE_URL_APP="postgresql://ultm8_app:changeme@localhost:5432/ultm8?schema=public"
# SELECT-only role used solely for pre-authentication credential lookup (login-by-email,
# registration's already-taken check) — see the user_auth_lookup RLS policy.
DATABASE_URL_AUTH="postgresql://ultm8_auth:changeme@localhost:5432/ultm8?schema=public"
# Phase 5 — background jobs with no single caller/tenant context (e.g.
# class-occurrence-generation, a cross-tenant sweep). SELECT on TimetableSlot/Branch,
# INSERT-only on Class — see prisma/migrations/20260908000000_timetable_module.
DATABASE_URL_JOBS="postgresql://ultm8_jobs:changeme@localhost:5432/ultm8?schema=public"
# Phase 14 — AcademiesModule's own dedicated role for cross-School discovery reads
# (browsing Schools the caller holds no RoleGrant at). Deliberately NOT ultm8_app or
# ultm8_jobs — see prisma/migrations/20260917000000_academies_discovery_module and
# Decision 94 (docs/decisions/POST-SPEC-55-DECISION-LOG.md) for why a shared role would
# have silently widened isolation for every other module reading the same tables.
# Column-level GRANTs restrict this role to exactly AcademiesService's curated fields.
DATABASE_URL_DISCOVERY="postgresql://ultm8_discovery:changeme@localhost:5432/ultm8?schema=public"
# Phase 26 — PlatformAdminModule's own dedicated role for cross-tenant business-logic
# reads (e.g. GET /platform-admin/schools/:id) and AuditLogEntry writes. Deliberately
# NOT ultm8_app or ultm8_discovery — see
# prisma/migrations/20260925000000_platform_admin_audit_log for why a shared role
# would have silently widened isolation for every other module reading the same
# tables (the exact mistake academies_discovery_module's own migration comment
# documents catching before it shipped). NOT used for AdminUser lookups themselves —
# those stay on DATABASE_URL_APP, unchanged from Phase 25.
DATABASE_URL_PLATFORM_ADMIN="postgresql://ultm8_platform_admin:changeme@localhost:5432/ultm8?schema=public"

JWT_ACCESS_SECRET="replace-with-a-real-secret-min-32-chars"
JWT_ACCESS_TTL="15m"

# Twilio Verify — Spec 55 §11.4 (confirmed OTP provider). Registration-flow only per
# Decision 72's own follow-up note: routine login uses passcode alone, not OTP.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Phase 15 — Spec 55 §11.4's confirmed email vendors (Postmark primary, AWS SES
# fallback, Decision 34). Same "app boots without it set" pattern as every other
# unconfigured external dependency here — email notifications fail until it's set.
# AWS SES credentials resolve via the SDK's standard provider chain, not an env var
# here (see NotificationDeliveryService's own comment).
NOTIFICATIONS_FROM_EMAIL=""
POSTMARK_SERVER_TOKEN=""
AWS_SES_REGION=""

# Phase 5 — first Redis/BullMQ usage in this codebase (otp-delivery,
# class-occurrence-generation). App boots without it reachable, same as every other
# unconfigured external dependency here — queue operations fail until it's set.
REDIS_URL="redis://localhost:6379"

# Phase 8 — Stripe (Spec 55 §10, §10.4; Decision 86: Connect account type is Express).
# ULTM8's own platform-level secret key — never a tenant's; PaymentsModule constructs
# a per-tenant scoped client from a Connected Account id instead (see
# StripeClientService.scopedClient()). App boots without it set, same as every other
# unconfigured external dependency here — Stripe API calls fail until it's set.
STRIPE_SECRET_KEY=""
# For stripe.webhooks.constructEvent() signature verification on
# POST /payments/webhooks/stripe — from the Stripe Dashboard's webhook-endpoint config.
STRIPE_WEBHOOK_SECRET=""
# Stripe Connect Express onboarding's own required Account Link redirect targets —
# Stripe's own API requirement, not a Spec 55-confirmed field; a Developer-level
# addition needed to make the confirmed onboarding flow actually functional, same
# treatment Phase 1 gave phoneVerifiedAt.
STRIPE_CONNECT_RETURN_URL="http://localhost:5173/payments/connect/return"
STRIPE_CONNECT_REFRESH_URL="http://localhost:5173/payments/connect/refresh"

# Platform Admin's own separate identity realm — AWS Cognito confirmed directly with
# the product owner (Decision 100, docs/decisions/POST-SPEC-55-DECISION-LOG.md), not
# this codebase's own guess; see ultm8-tenant-isolation SKILL.md §3. A dedicated User
# Pool for Platform Admin staff only, MFA set to Required at the Pool's own
# configuration (Spec §4.4: "SSO against the company's own identity provider plus
# mandatory 2FA") — never the same Pool, secret, or JWT issuer/audience as anything
# customer-facing. This codebase has no AWS credentials of its own and cannot
# provision the actual User Pool — that's real infrastructure the product owner sets
# up separately; these two values just point at it once it exists. App boots without
# these set, same convention as every other unconfigured external dependency here —
# POST /platform-admin/auth/exchange fails until they are.
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
# ULTM8's own token for the Platform Admin realm, issued after verifying a Cognito ID
# token — deliberately a different secret from JWT_ACCESS_SECRET (see
# PlatformAdminModule's own header comment for why one realm must be structurally
# incapable of verifying the other's tokens, not just conventionally kept apart).
PLATFORM_ADMIN_JWT_SECRET="replace-with-a-different-real-secret-min-32-chars"
# Shorter than the tenant realm's spec-confirmed 15-minute default (Spec §8.3) — this
# 5-minute figure is a Developer-level engineering placeholder, NOT itself
# spec-confirmed or product-owner-approved (Decision 100's own "What this does NOT
# resolve"). See PlatformAdminModule's own comment for the full account, including
# what this TTL is the sole mitigation for today.
PLATFORM_ADMIN_JWT_TTL="5m"
# Phase 43 (Decision 102) — how long a Support-issued impersonation session stays
# valid, in whole seconds (not "5m"-style duration syntax like the two above — this
# one is passed straight to @nestjs/jwt's own per-call `expiresIn` option as a
# caller-supplied number, not read from JwtModule.register()'s static config).
# Same "Developer-level placeholder, open to revision" status as
# PLATFORM_ADMIN_JWT_TTL above — Decision 102 confirms "time-boxed," not a
# specific number. See PlatformAdminImpersonationService's own comment.
PLATFORM_ADMIN_IMPERSONATION_TTL_SECONDS="600"

# Phase 51 (Decision 107) — the rotating QR check-in tokens. Two DELIBERATELY
# SEPARATE secrets (never share one) so a captured Class token can never be
# replayed as a Student token or vice versa — see QrTokenService's own header
# comment. Same "Developer-level placeholder" status as the TTLs above; the TTL
# itself is a whole-seconds number, same convention as
# PLATFORM_ADMIN_IMPERSONATION_TTL_SECONDS.
QR_CLASS_TOKEN_SECRET="replace-with-a-different-real-secret-min-32-chars"
QR_STUDENT_TOKEN_SECRET="replace-with-a-different-real-secret-min-32-chars"
QR_ATTENDANCE_TOKEN_TTL_SECONDS="20"

# Cloudflare R2 (S3-compatible object storage) — Spec 55 §11.3's confirmed
# object-storage vendor. First real use in this codebase: drawn-signature-capture
# images for WaiverSignature (Decision 74/78, Phase 34 — see that model's own
# schema comment and R2ClientService's own header comment for the full account).
# This codebase has no AWS/Cloudflare credentials of its own and cannot provision
# the actual bucket — that's real infrastructure the product owner sets up
# separately, same standing gap as Cognito's User Pool. The bucket MUST be
# created WITHOUT public access enabled — every read of a stored image goes
# through a freshly-generated presigned GET URL (R2ClientService), never a
# permanently public link, given Spec 55 §12.2 leaves data-residency/GDPR/LGPD
# compliance for R2-stored assets genuinely open platform-wide. App boots
# without these set, same convention as every other unconfigured external
# dependency here — the signature-upload-url/sign endpoints fail until they are.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

PORT=3000

# Comma-separated list of origins allowed to call this API cross-origin (browser
# clients, e.g. apps/school-portal). Defaults to http://localhost:5173 if unset —
# see main.ts's own comment for why this fails safe rather than falling back to a
# permissive default.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
